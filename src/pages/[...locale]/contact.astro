---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { localeStaticPaths, messages } from "../../i18n/utils";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
import { site } from "../../data/site";
const c = m.contact;
---

<BaseLayout lang={lang} path="/contact/" title={c.title} description={c.lead}>
  <PageHero title={c.title} lead={c.lead} />
  <section class="section">
    <div class="container stack">
      <div class="email-row">
        <h3>{c.emailTitle}</h3>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <article class="org">
        <div class="org-info">
          <h3>{c.organiserTitle}</h3>
          <p>{c.organiserText}</p>
          <p>{c.businessId}: {site.businessId}</p>
          <p>{c.chairmanText}</p>
        </div>
        <div class="org-purpose">
          <h3>{c.aboutTitle}</h3>
          <p>{c.aboutText}</p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--space-5); }
  h3 { font-size: 1.6rem; }
  .org h3 { margin: 0; }
  .email-row h3 { margin: 0; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); padding: var(--space-4) var(--space-6); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .org { display: grid; grid-template-columns: 1fr 1.4fr; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); overflow: hidden; }
  .org-info, .org-purpose { padding: var(--box-pad); display: grid; gap: var(--space-3); align-content: start; }
  .org-purpose { border-left: 1px solid var(--line-strong); background: var(--ice-dim); }
  .org p { color: var(--muted); }
  @media (max-width: 820px) {
    .org { grid-template-columns: 1fr; }
    .org-purpose { border-left: 0; border-top: 1px solid var(--line-strong); }
  }
</style>
