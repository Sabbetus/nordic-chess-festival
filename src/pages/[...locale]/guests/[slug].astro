---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, defaultLocale, localePath, messages, formatMonthYear } from "../../../i18n/utils";
import { titleLabel } from "../../../lib/titles";

export async function getStaticPaths() {
  const guests = await getCollection("guests");
  return locales.flatMap((lang) =>
    guests.map((guest) => ({
      params: { locale: lang === defaultLocale ? undefined : lang, slug: guest.id },
      props: { lang, guest },
    })),
  );
}

const { lang, guest } = Astro.props;
const m = messages[lang];
const d = guest.data;
const fullName = `${d.title ? titleLabel(lang, d.title) + " " : ""}${d.name}`;
const paragraphs = d.bio[lang].trim().split(/\n\s*\n/);
const spread = d.photo ? Math.max(1, d.photo.width / d.photo.height / 0.8) : 1;
const widths = d.photo
  ? [...new Set([480, 640, 800, 1200, 1600, 2000].filter((w) => w < d.photo!.width).concat(d.photo.width))].sort((a, b) => a - b)
  : [];
const sizes = `(min-width: 900px) ${Math.round(480 * spread)}px, ${Math.round(90 * spread)}vw`;
const initials = d.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join("");
// The picture used when this page is shared (see src/pages/og/guests/[slug].jpg.ts).
const hasShareImage = Boolean(d.photo) && !d.placeholder;
const shareImage = hasShareImage ? `/og/guests/${guest.id}.jpg` : undefined;
const shareWidth = d.photo ? Math.min(d.photo.width, 1200) : undefined;
const jobTitles: Record<string, string> = {
  GM: "Chess grandmaster", WGM: "Chess woman grandmaster", IM: "Chess international master", WIM: "Chess woman international master",
  FM: "Chess FIDE master", WFM: "Chess woman FIDE master", CM: "Chess candidate master", WCM: "Chess woman candidate master",
};
const jobTitle = [d.title ? jobTitles[d.title] : undefined, d.kind === "creator" ? "chess content creator" : undefined].filter(Boolean).join(" and ");
const pageUrl = new URL(localePath(lang, `/guests/${guest.id}/`), Astro.site!).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: d.name,
  url: pageUrl,
  ...(jobTitle ? { jobTitle: jobTitle.charAt(0).toUpperCase() + jobTitle.slice(1) } : {}),
  ...(d.tagline ? { description: d.tagline[lang] } : {}),
  ...(shareImage ? { image: new URL(shareImage, Astro.site!).href } : {}),
  knowsAbout: "Chess",
  ...(d.fideId ? { identifier: { "@type": "PropertyValue", propertyID: "FIDE ID", value: String(d.fideId) } } : {}),
  ...(d.links.length ? { sameAs: d.links.map((l) => l.url) } : {}),
};
---

<BaseLayout lang={lang} path={`/guests/${guest.id}/`} title={fullName} description={[`${fullName}${d.tagline ? `: ${d.tagline[lang]}` : ''}.`, m.meta.pages.guestSuffix].join(' ')} jsonLd={d.placeholder ? undefined : jsonLd} image={shareImage} imageWidth={shareWidth} imageHeight={shareWidth ? Math.round(shareWidth / 1.91) : undefined} imageAlt={shareImage ? (d.photoAlt?.[lang] ?? d.name) : undefined} noindex={d.placeholder}>
  <section class="section profile">
    <div class="container">
      <a class="back" href={localePath(lang, "/guests/")}>← {m.guests.backToGuests}</a>
      <div class="layout">
        <figure class="photo">
          {d.photo ? (
            <Image src={d.photo} alt={d.photoAlt?.[lang] ?? d.name} widths={widths} sizes={sizes} quality={82} loading="eager" style={d.photoPosition ? `object-position: ${d.photoPosition}` : undefined} />
          ) : (
            <span class="mono" aria-hidden="true">{initials}</span>
          )}
          {d.photoCredit && (
            <figcaption>
              {m.common.photoCredit}: {d.photoCredit}
              {d.photoSourceUrl && <> · <a href={d.photoSourceUrl} target="_blank" rel="noopener">{new URL(d.photoSourceUrl).hostname.includes("wikimedia") ? "Wikimedia Commons" : new URL(d.photoSourceUrl).hostname}</a></>}
            </figcaption>
          )}
        </figure>
        <div class="stack">
          {d.placeholder && <p class="eyebrow">{m.guests.placeholderBadge}</p>}
          <h1><span class="name">{fullName}</span></h1>
          {d.tagline && <p class="lead"><span class="tag">{d.tagline[lang]}</span></p>}
          <dl class="facts">
            {d.federation && <div><dt>{m.guests.federation}</dt><dd>{d.federation}</dd></div>}
            {d.rating && (
              <div>
                <dt>{m.guests.rating} · {formatMonthYear(lang, d.rating.month)}</dt>
                <dd class="num">{d.fideId ? <a href={`https://ratings.fide.com/profile/${d.fideId}`} target="_blank" rel="noopener">{d.rating.value}</a> : d.rating.value}</dd>
              </div>
            )}
            {d.peakRating && <div><dt>{m.guests.peakRating}</dt><dd class="num">{d.peakRating}</dd></div>}
          </dl>
          <div class="prose">{paragraphs.map((p) => <p>{p}</p>)}</div>
          {d.links.length > 0 && (
            <div>
              <h2 class="links-title">{m.guests.links}</h2>
              <p class="btn-row">{d.links.map((l) => <a class="btn btn-ghost btn-sm" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile { --h1-size: clamp(2.5rem, 5vw, 4.5rem); border-top: 0; padding-top: var(--space-6); }
  .back { font-size: var(--text-sm); color: var(--muted); display: inline-block; margin-bottom: var(--space-6); }
  .layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); align-items: start; }
  .photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: linear-gradient(160deg, var(--surface-2), var(--surface)); display: grid; place-items: center; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* The credit is always one line: the script below shrinks the text to fit; without script it is cut off with an ellipsis. */
  .photo figcaption { position: absolute; bottom: 0; left: 0; right: 0; padding: var(--space-2) var(--space-3); font-size: var(--text-xs); color: var(--muted); background: rgba(10, 10, 10, 0.78); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .photo figcaption a:hover { color: var(--ice); }
  .mono { font-family: var(--font-display); font-size: 8rem; color: var(--ice); opacity: 0.5; }
  h1 { font-size: var(--h1-size); }
  /* Two-column layout: the name always sits on one line (the script below shrinks long names to fit the column), in a box of
     the same height on every guest page, so that everything under it lines up from page to page. */
  @media (min-width: 901px) {
    /* The photo stays where it is (it does not follow the scrolling) and starts level with the top of the name. */
    .photo { margin-top: calc(var(--h1-size) * 0.37); }
    h1 { height: 1.2em; display: flex; align-items: center; }
    .name { display: inline-block; white-space: nowrap; }
    /* The tagline too: one line (shrunk to fit by the script below) in a box of a fixed height. */
    .stack > .lead { max-width: none; height: 1.6em; line-height: 1.6; display: flex; align-items: center; }
    .tag { display: inline-block; white-space: nowrap; }
  }
  .facts { display: flex; gap: var(--space-6); flex-wrap: wrap; }
  .facts div { display: flex; flex-direction: column-reverse; gap: 0.2rem; }
  .facts dd { font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1; }
  .facts dd a { color: inherit; border-bottom: 1px dotted var(--ice-border); }
  .facts dd a:hover { color: var(--ice); }
  .facts dt { font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .links-title { font-size: 1.5rem; margin-bottom: var(--space-3); }
  /* Narrow screens: one column, the photo above the text (max 24rem wide); it stays positioned (relative) so that the credit sits at its bottom edge. */
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; gap: var(--space-5); } .photo { max-width: 24rem; } }
</style>

<script>
  // Desktop: scale the guest's name and tagline down until each fits on one line (never below 28 px for the name and 12 px
  // for the tagline; below that they wrap as usual).
  const fitLine = (box: HTMLElement | null, text: HTMLElement | null | undefined, floor: number) => {
    if (!box || !text) return;
    text.style.fontSize = '';
    text.style.whiteSpace = '';
    if (!window.matchMedia('(min-width: 901px)').matches) return;
    const full = parseFloat(getComputedStyle(box).fontSize);
    const room = box.clientWidth;
    if (text.scrollWidth <= room) return;
    const size = Math.floor(full * (room / text.scrollWidth) * 0.99 * 4) / 4;
    if (size >= floor) text.style.fontSize = `${size}px`;
    else {
      text.style.fontSize = `${floor}px`;
      text.style.whiteSpace = 'normal';
    }
  };
  const fitLines = () => {
    const h1 = document.querySelector<HTMLElement>('.profile h1');
    fitLine(h1, h1?.querySelector<HTMLElement>('.name'), 28);
    const lead = document.querySelector<HTMLElement>('.profile .stack > .lead');
    fitLine(lead, lead?.querySelector<HTMLElement>('.tag'), 12);
  };
  fitLines();
  document.fonts?.ready.then(fitLines);
  window.addEventListener('resize', fitLines);

  // Keep the photo credit on one line: shrink its text a little at a time until it fits the width of the photo (never below 8 px).
  const fitCredit = () => {
    const caption = document.querySelector<HTMLElement>('.photo figcaption');
    if (!caption) return;
    caption.style.fontSize = '';
    let size = parseFloat(getComputedStyle(caption).fontSize);
    while (caption.scrollWidth > caption.clientWidth && size > 8) {
      size -= 0.25;
      caption.style.fontSize = `${size}px`;
    }
  };
  fitCredit();
  document.fonts?.ready.then(fitCredit);
  window.addEventListener('resize', fitCredit);
</script>
