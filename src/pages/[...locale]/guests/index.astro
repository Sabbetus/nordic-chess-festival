---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { localeStaticPaths, messages } from "../../../i18n/utils";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
import { getCollection } from "astro:content";
import GuestCard from "../../../components/GuestCard.astro";
const g = m.guests;
const all = (await getCollection("guests")).sort((a, b) => a.data.order - b.data.order);
// One grid for everyone, in the order set in the guest files (`order`): the cards say who is a grandmaster, a content creator and so on.
---

<BaseLayout lang={lang} path="/guests/" title={g.title} description={g.lead}>
  <PageHero title={g.title} lead={g.lead} />
  <section class="section">
    <div class="container">
      {all.length === 0 ? (
        <div class="notice"><p>{g.empty}</p></div>
      ) : (
        <div class="guest-grid-lg">{all.map((x) => <GuestCard guest={x} lang={lang} colour />)}</div>
      )}
    </div>
  </section>
</BaseLayout>

