---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { localeStaticPaths, messages } from "../../i18n/utils";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
const p = m.privacy;
---

<BaseLayout lang={lang} path="/privacy/" title={p.title} description={p.lead}>
  <PageHero title={p.title} lead={p.lead} />
  <section class="section"><div class="container narrow stack"><p class="prose">{p.text}</p><span class="placeholder-note">{m.common.placeholder}</span></div></section>
</BaseLayout>
