---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuestCard from '../../components/GuestCard.astro';
import Countdown from '../../components/Countdown.astro';
import RoundTiles from '../../components/RoundTiles.astro';
import Newsletter from '../../components/Newsletter.astro';
import { localeStaticPaths, localePath, messages, formatDate, formatDayShort } from '../../i18n/utils';
import { festival } from '../../data/fees';
import { schedule, venue } from '../../data/schedule';
import { site } from '../../data/site';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props;
const m = messages[lang];
const h = m.home;

const guests = (await getCollection('guests')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news'))
  .filter((n) => n.id.startsWith(`${lang}/`) && !n.data.placeholder)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const opening = schedule.find((i) => i.kind === 'opening')!;
const prizegiving = schedule.find((i) => i.kind === 'prizegiving')!;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: festival.name, url: site.url },
  {
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${festival.name} ${festival.year}`,
    description: messages.en.meta.description,
    startDate: festival.startDate,
    endDate: festival.endDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: venue.name,
      address: {
        '@type': 'PostalAddress',
        streetAddress: venue.street,
        addressLocality: venue.city,
        addressCountry: venue.countryCode,
      },
    },
    organizer: { '@type': 'Organization', name: site.organiser, url: site.url, email: site.email },
    url: site.url,
    image: `${site.url}/preview.jpg`,
    sport: 'Chess',
  },
];
---

<BaseLayout lang={lang} path="/" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="floor" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">♛ {h.eyebrow}</p>
        <h1 class="reveal reveal-1">
          <span class="line">Nordic <em>Chess</em></span>
          <span class="line">Festival</span>
        </h1>
        <p class="lead reveal reveal-2">{h.lead}</p>
        <p class="btn-row reveal reveal-3">
          <a class="btn btn-primary" href={localePath(lang, '/register/')}>{h.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={localePath(lang, '/tournament/#schedule')}>{h.ctaSecondary}</a>
        </p>
        <p class="pill reveal reveal-4" data-early-bird><span class="dot" aria-hidden="true"></span>{h.earlyBirdPill}</p>
      </div>
      <div class="hero-side reveal reveal-3">
        <p class="bigdate" aria-hidden="true"><span class="d">12–20</span><span class="mo">{h.bigMonth}</span></p>
        <Countdown lang={lang} />
      </div>
    </div>
    <div class="container">
      <dl class="facts reveal reveal-4">
        {h.facts.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- GUESTS -->
  <section class="section surface">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <p class="eyebrow rule">{h.guests.eyebrow}</p>
          <h2>{h.guests.title}</h2>
          <p class="lead">{h.guests.text}</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={localePath(lang, '/guests/')}>{m.common.viewAll}</a>
      </div>
      <div class="guest-grid">
        {guests.map((g) => <GuestCard guest={g} lang={lang} />)}
      </div>
      <p class="more">{h.guests.more}</p>
    </div>
  </section>

  <!-- TOURNAMENT -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <p class="eyebrow rule">{h.glance.eyebrow}</p>
          <h2>{h.glance.title}</h2>
          <p class="lead">{h.glance.text}</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={localePath(lang, '/tournament/')}>{h.glance.link}</a>
      </div>
      <RoundTiles lang={lang} />
      <ul class="ceremonies">
        <li><span>{h.glance.opening}</span> <strong class="num">{formatDayShort(lang, opening.date)} · {opening.time}</strong></li>
        <li><span>{h.glance.prizegiving}</span> <strong class="num">{formatDayShort(lang, prizegiving.date)} · {prizegiving.time}</strong></li>
      </ul>
    </div>
  </section>

  <!-- FEES + VENUE -->
  <section class="section surface">
    <div class="container panels">
      <article class="panel">
        <p class="eyebrow rule">{h.fees.eyebrow}</p>
        <div data-early-bird>
          <h2>{h.fees.title}</h2>
          <p class="lead">{h.fees.text}</p>
        </div>
        <div class="after-early-bird">
          <h2>{m.nav.register}</h2>
          <p class="lead">{h.fees.textAfter}</p>
        </div>
        <p class="free">{h.fees.free}</p>
        <p class="btn-row"><a class="btn btn-primary" href={localePath(lang, '/register/')}>{h.fees.cta} <span class="arrow" aria-hidden="true">→</span></a></p>
      </article>
      <article class="panel">
        <p class="eyebrow rule">{h.venue.eyebrow}</p>
        <h2>{venue.name}</h2>
        <p class="lead">{h.venue.text}</p>
        <p class="addr">{venue.street}<br />{venue.city}, {venue.country}</p>
        <p class="btn-row">
          <a class="btn btn-ghost" href={localePath(lang, '/travel/')}>{h.venue.cta}</a>
          <a class="btn btn-ghost" href={venue.mapUrl} target="_blank" rel="noopener">{h.venue.map}</a>
        </p>
      </article>
    </div>
  </section>

  <!-- NEWS -->
  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{h.newsTitle}</h2>
          <a class="btn btn-ghost btn-sm" href={localePath(lang, '/news/')}>{m.news.allNews}</a>
        </div>
        <div class="grid grid-3">
          {news.map((n) => (
            <a class="card" href={localePath(lang, `/news/${n.id.split('/')[1]}/`)}>
              <p class="eyebrow">{formatDate(lang, n.data.date)}</p>
              <h3>{n.data.title}</h3>
              <p>{n.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Newsletter lang={lang} />

  <section class="partners">
    <div class="container">
      <p>
        {h.partnersLabel}
        {site.partners.map((p, i) => (
          <>{i > 0 && ' & '}<a href={p.url} target="_blank" rel="noopener">{p.name}</a></>
        ))}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(3.5rem, 9vw, 7rem) var(--space-7); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(55% 60% at 82% 8%, rgba(126, 200, 227, 0.2), transparent 70%),
      radial-gradient(45% 45% at 8% 100%, rgba(126, 200, 227, 0.08), transparent 70%);
  }
  /* A chessboard receding into the distance */
  .floor {
    position: absolute; z-index: -1; left: -30%; right: -30%; bottom: -4%; height: 62%; pointer-events: none;
    perspective: 620px; perspective-origin: 50% 0;
  }
  .floor::before {
    content: ''; position: absolute; inset: 0; transform-origin: 50% 100%; transform: rotateX(64deg) translateZ(0);
    background: repeating-conic-gradient(rgba(126, 200, 227, 0.1) 0% 25%, transparent 0% 50%) 50% 0 / 9rem 9rem;
    -webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 92%);
    mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 92%);
  }
  .hero-side { display: grid; gap: var(--space-5); }
  .bigdate { display: grid; justify-items: end; line-height: 0.85; user-select: none; }
  .bigdate .d {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(6rem, 13vw, 12rem); letter-spacing: -0.03em;
    color: transparent; -webkit-text-stroke: 1px rgba(126, 200, 227, 0.38);
  }
  .bigdate .mo { font-size: var(--text-xs); letter-spacing: 0.42em; text-transform: uppercase; color: var(--ice); margin-top: var(--space-3); margin-right: 0.2rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: var(--space-7); align-items: end; }
  .hero h1 { font-size: clamp(3.4rem, 9.2vw, 9rem); line-height: 0.92; margin-block: var(--space-5) var(--space-5); letter-spacing: -0.02em; }
  .hero h1 .line { display: block; }
  .hero .lead { font-size: var(--text-lg); max-width: 38rem; }
  .hero .btn-row { margin-top: var(--space-6); }
  .pill {
    display: inline-flex; align-items: center; gap: 0.6rem; margin-top: var(--space-5); padding: 0.55rem 1rem;
    border: 1px solid var(--ice-border); border-radius: 999px; background: var(--ice-dim);
    font-size: var(--text-sm); color: var(--ice); letter-spacing: 0.02em;
  }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ice); box-shadow: 0 0 0 0 rgba(126, 200, 227, 0.6); animation: pulse 2.4s var(--ease) infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 0.6rem rgba(126, 200, 227, 0); } 100% { box-shadow: 0 0 0 0 rgba(126, 200, 227, 0); } }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line-strong); }
  .facts div { display: flex; flex-direction: column-reverse; gap: 0.3rem; }
  .facts dd { font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1; }
  .facts dt { font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }

  /* ---------- Sections ---------- */
  .surface { background: linear-gradient(180deg, var(--surface) 0%, rgba(17, 17, 17, 0.4) 100%); }
  .head-text { max-width: 40rem; display: grid; gap: var(--space-3); }
  .head-text .lead { margin-top: var(--space-2); }
  .guest-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-4); }
  .more { margin-top: var(--space-5); font-size: var(--text-sm); color: var(--muted-2); letter-spacing: 0.04em; }
  .ceremonies { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-7); margin-top: var(--space-5); font-size: var(--text-sm); color: var(--muted); }
  .ceremonies strong { color: var(--white); font-weight: 500; margin-left: var(--space-2); }

  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .panel {
    position: relative; overflow: hidden; background: var(--black); border: 1px solid var(--line-strong); border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 3rem); display: grid; gap: var(--space-4); align-content: start;
  }
  .panel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--ice), transparent); opacity: 0.7; }
  .panel h2 { font-size: clamp(2rem, 3.4vw, 3rem); }
  .panel .free { color: var(--white); font-size: var(--text-sm); letter-spacing: 0.04em; }
  .addr { color: var(--white); font-size: 1.05rem; line-height: 1.6; }

  .partners { border-top: 1px solid var(--line); padding-block: var(--space-5); text-align: center; position: relative; z-index: 1; }
  .partners p { font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); }
  .partners a { color: var(--muted); }
  .partners a:hover { color: var(--ice); }

  @media (max-width: 1100px) {
    .guest-grid { grid-template-columns: repeat(3, 1fr); }
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-6); align-items: start; }
    .bigdate { display: none; }
    .panels { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .guest-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
    .facts { grid-template-columns: 1fr 1fr; gap: var(--space-5) var(--space-4); margin-top: var(--space-7); }
    .floor { height: 40%; }
  }
</style>
