---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuestCard from '../../components/GuestCard.astro';
import Countdown from '../../components/Countdown.astro';
import RoundTiles from '../../components/RoundTiles.astro';
import NewsCard from '../../components/NewsCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import LocationBand from '../../components/LocationBand.astro';
import { localeStaticPaths, localePath, messages, formatDayShort } from '../../i18n/utils';
import { festival } from '../../data/fees';
import { schedule, venue } from '../../data/schedule';
import { site } from '../../data/site';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props;
const m = messages[lang];
const h = m.home;

const guests = (await getCollection('guests')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news'))
  .filter((n) => n.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Phones show one guest per row and only the first few; "view all" leads to the rest.
const MOBILE_GUESTS = 5;

// When the last row of the three-column grid is not full, a placeholder card fills it.
const fillsRow = guests.length % 3 === 0;
const opening = schedule.find((i) => i.kind === 'opening')!;
const prizegiving = schedule.find((i) => i.kind === 'prizegiving')!;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: festival.name, url: site.url },
  {
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${festival.name} ${festival.year}`,
    description: messages.en.meta.description,
    startDate: festival.startDate,
    endDate: festival.endDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: venue.name,
      address: {
        '@type': 'PostalAddress',
        streetAddress: venue.street,
        addressLocality: venue.city,
        addressCountry: venue.countryCode,
      },
    },
    organizer: { '@type': 'Organization', name: site.organiser, url: site.url, email: site.email },
    url: site.url,
    image: `${site.url}/preview.jpg`,
    sport: 'Chess',
  },
];
---

<BaseLayout lang={lang} path="/" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="floor" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow reveal">♛ {h.eyebrow}</p>
      <h1 class="reveal reveal-1">Nordic <em>Chess</em> Festival</h1>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lead reveal reveal-2">
            {h.leadLines.map((line, i) => (
              <><span class:list={{ accent: i === h.leadLines.length - 1 }}>{line}</span>{' '}</>
            ))}
          </p>
          <p class="btn-row reveal reveal-3">
            <a class="btn btn-primary" href={localePath(lang, '/register/')}>{h.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={localePath(lang, '/main-event/#schedule')}>{h.ctaSecondary}</a>
          </p>
        </div>
        <div class="hero-side reveal reveal-3">
          <Countdown lang={lang} />
        </div>
      </div>

      <dl class="facts reveal reveal-4">
        {h.facts.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- GUESTS -->
  <section class="section surface">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <p class="eyebrow rule">{h.guests.eyebrow}</p>
          <h2>{h.guests.title}</h2>
          <p class="lead">{h.guests.text}</p>
        </div>
        <a class="btn btn-ghost btn-sm head-link" href={localePath(lang, '/guests/')}>{m.common.viewAll}</a>
      </div>
      <div class="guest-grid">
        {guests.map((g, i) => <div class="guest-item" data-extra={i >= MOBILE_GUESTS ? '' : undefined}><GuestCard guest={g} lang={lang} /></div>)}
        {!fillsRow && <div class="guest-more"><p>{h.guests.more}</p></div>}
      </div>
      <p class={fillsRow ? 'more' : 'more mobile-more'}>{h.guests.more}</p>
      <p class="btn-row guests-all"><a class="btn btn-ghost" href={localePath(lang, '/guests/')}>{m.common.viewAll} <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- MAIN EVENT -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <p class="eyebrow rule">{h.glance.eyebrow}</p>
          <h2>{h.glance.title}</h2>
          <p class="lead">{h.glance.text}</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={localePath(lang, '/main-event/')}>{h.glance.link}</a>
      </div>
      <RoundTiles lang={lang} />
      <ul class="ceremonies">
        <li><span>{h.glance.opening}</span> <strong class="num">{formatDayShort(lang, opening.date)} · {opening.time}</strong></li>
        <li><span>{h.glance.prizegiving}</span> <strong class="num">{formatDayShort(lang, prizegiving.date)} · {prizegiving.time}</strong></li>
      </ul>
    </div>
  </section>

  <!-- PRIZES -->
  <section class="section prize">
    <div class="container">
      <p class="eyebrow rule prize-eyebrow">{h.prize.eyebrow}</p>
      <div class="prize-grid">
      <div class="amount">
        <p class="prefix">{m.prizes.amountPrefix}</p>
        <p class="big lining">{m.prizes.amount}</p>
        <p class="note">{m.prizes.amountNote}</p>
      </div>
      <div class="prize-copy">
        <p class="lead">{h.prize.text}</p>
        <p class="btn-row"><a class="btn btn-ghost" href={localePath(lang, '/prizes/')}>{h.prize.cta}</a></p>
      </div>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="head-text">
          <p class="eyebrow rule">{m.nav.news}</p>
          <h2>{h.newsTitle}</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href={localePath(lang, '/news/')}>{m.news.allNews}</a>
      </div>
      {news.length === 0 ? (
        <div class="notice"><p>{h.newsEmpty}</p></div>
      ) : (
        <div class="news-grid">
          {news.map((n, i) => <NewsCard entry={n} lang={lang} featured={i === 0} />)}
        </div>
      )}
    </div>
  </section>

  <LocationBand lang={lang} />

  <!-- FEES + VENUE -->
  <section class="section surface">
    <div class="container">
     <div class="panels">
      <article class="panel">
        <p class="eyebrow rule">{h.fees.eyebrow}</p>
        <div data-early-bird>
          <h2>{h.fees.title}</h2>
          <p class="lead">{h.fees.text}</p>
        </div>
        <div class="after-early-bird">
          <h2>{m.nav.register}</h2>
          <p class="lead">{h.fees.textAfter}</p>
        </div>
        <p class="free">{h.fees.free}</p>
        <p class="btn-row"><a class="btn btn-primary" href={localePath(lang, '/register/#fees')}>{h.fees.cta} <span class="arrow" aria-hidden="true">→</span></a></p>
      </article>
      <article class="panel">
        <p class="eyebrow rule">{h.venue.eyebrow}</p>
        <h2>{venue.name}</h2>
        <p class="lead">{h.venue.text}</p>
        <p class="addr">{venue.street}<br />{venue.city}, {venue.country}</p>
        <p class="btn-row">
          <a class="btn btn-ghost" href={localePath(lang, '/travel/')}>{h.venue.cta}</a>
          <a class="btn btn-ghost" href={venue.mapUrl} target="_blank" rel="noopener">{h.venue.map}</a>
        </p>
      </article>
     </div>
    </div>
  </section>

  <Newsletter lang={lang} />

  <section class="partners">
    <div class="container">
      <p>
        {h.partnersLabel}
        {site.partners.map((p, i) => (
          <>{i > 0 && ' & '}<a href={p.url} target="_blank" rel="noopener">{p.name}</a></>
        ))}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(3.5rem, 8vw, 6.5rem) var(--space-7); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(55% 60% at 82% 8%, rgba(126, 200, 227, 0.2), transparent 70%),
      radial-gradient(45% 45% at 8% 100%, rgba(126, 200, 227, 0.08), transparent 70%);
  }
  /* A chessboard receding into the distance */
  .floor {
    position: absolute; z-index: -1; left: -30%; right: -30%; bottom: -4%; height: 62%; pointer-events: none;
    perspective: 620px; perspective-origin: 50% 0;
  }
  .floor::before {
    content: ''; position: absolute; inset: 0; transform-origin: 50% 100%; transform: rotateX(64deg) translateZ(0);
    background: repeating-conic-gradient(rgba(126, 200, 227, 0.1) 0% 25%, transparent 0% 50%) 50% 0 / 9rem 9rem;
    -webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 92%);
    mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 92%);
  }
  /* One line, scaled to the container width */
  .hero h1 {
    font-size: clamp(1.75rem, 6.4vw, 5.6rem); line-height: 1.02; letter-spacing: -0.02em; white-space: nowrap;
    margin-block: var(--space-4) var(--space-6);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--space-7); align-items: end; }
  .hero-copy { display: grid; gap: var(--space-6); align-content: end; }
  .hero .lead { font-size: var(--text-lg); max-width: 42rem; }
  .hero .lead .accent { color: var(--ice); }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line-strong); }
  .facts div { display: flex; flex-direction: column-reverse; gap: 0.3rem; }
  .facts dd { font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1; white-space: nowrap; }
  .facts dt { font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }

  /* ---------- Sections ---------- */
  .surface { background: linear-gradient(180deg, var(--surface) 0%, rgba(17, 17, 17, 0.4) 100%); }
  .section-head h2 { font-size: var(--text-h2-lg); }
  .head-text { max-width: 62rem; display: grid; gap: var(--space-3); }
  .head-text .lead { margin-top: var(--space-2); max-width: 52rem; }
  .guest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); --guest-aspect: 4 / 5; }
  .guest-item { display: contents; }
  .guests-all { display: none; margin-top: var(--space-5); }
  .mobile-more { display: none; }
  .guest-more { aspect-ratio: var(--guest-aspect, 3 / 4); border: 1px dashed var(--line-strong); border-radius: var(--radius); display: grid; place-items: center; padding: var(--space-5); text-align: center; color: var(--muted); font-size: var(--text-sm); letter-spacing: 0.04em; }
  .more { margin-top: var(--space-5); font-size: var(--text-sm); color: var(--muted-2); letter-spacing: 0.04em; }
  .ceremonies { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-7); margin-top: var(--space-5); font-size: var(--text-sm); color: var(--muted); }
  .ceremonies strong { color: var(--white); font-weight: 500; margin-left: var(--space-2); }

  .prize { position: relative; overflow: hidden; }
  .prize::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(45% 80% at 18% 50%, rgba(126, 200, 227, 0.13), transparent 70%); }
  .prize-eyebrow { margin-bottom: var(--space-4); }
  /* Both halves are centred on the same line, with a hairline between them. */
  .prize-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-7); align-items: center; }
  .amount { display: grid; gap: var(--space-2); align-content: start; }
  .amount .prefix { font-size: var(--text-sm); letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); }
  .amount .big { font-family: var(--font-display); font-weight: 600; font-size: clamp(3rem, 7vw, 5.75rem); line-height: 1; letter-spacing: -0.02em; color: var(--ice); white-space: nowrap; }
  .amount .note { font-size: var(--text-xs); letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .prize-copy { display: grid; gap: var(--space-5); border-left: 1px solid var(--line-strong); padding-left: var(--space-7); }
  .prize-copy .lead { max-width: 34rem; }

  /* One framed band, two halves with a hairline between them; the buttons line up along the bottom. */
  .panels {
    display: grid; grid-template-columns: 1fr 1fr; position: relative; overflow: hidden;
    border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--black);
  }
  .panels::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--ice), transparent 70%); opacity: 0.7; }
  .panel {
    position: relative; padding: clamp(1.5rem, 3.5vw, 2.75rem); display: flex; flex-direction: column; gap: var(--space-4);
    background: radial-gradient(70% 60% at 0% 0%, rgba(126, 200, 227, 0.07), transparent 70%);
  }
  .panel + .panel { border-left: 1px solid var(--line-strong); background: radial-gradient(70% 60% at 100% 0%, rgba(126, 200, 227, 0.05), transparent 70%); }
  .panel [data-early-bird] { display: grid; gap: var(--space-4); }
  :global(.early-bird-over) .panel .after-early-bird { display: grid; gap: var(--space-4); }
  .panel .btn-row { margin-top: auto; padding-top: var(--space-2); }
  .panel h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); }
  .panel .lead { max-width: none; }
  .panel .free { color: var(--white); font-size: var(--text-sm); letter-spacing: 0.04em; }
  .addr { color: var(--white); font-size: 1.05rem; line-height: 1.6; }

  .news-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-5); }
  .news-grid > :first-child { grid-row: span 2; }
  .news-grid:has(> :only-child) { grid-template-columns: minmax(0, 1fr); }
  .news-grid:has(> :nth-child(2):last-child) > :first-child { grid-row: auto; }

  .partners { border-top: 1px solid var(--line); padding-block: var(--space-5); text-align: center; position: relative; z-index: 1; }
  .partners p { font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); }
  .partners a { color: var(--muted); }
  .partners a:hover { color: var(--ice); }

  @media (max-width: 1100px) {
    .guest-grid { grid-template-columns: repeat(2, 1fr); }
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-6); align-items: start; }
    .panels { grid-template-columns: 1fr; }
    .panel + .panel { border-left: 0; border-top: 1px solid var(--line-strong); }
    .prize-grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .prize-copy { border-left: 0; padding-left: 0; border-top: 1px solid var(--line-strong); padding-top: var(--space-5); }
    .news-grid { grid-template-columns: minmax(0, 1fr); }
    .news-grid > :first-child { grid-row: auto; }
  }
  @media (max-width: 700px) {
    /* One guest per row, like the guests page, and the dashed placeholder gives way to the text line below. */
    .guest-grid { grid-template-columns: 1fr; gap: var(--space-5); --guest-aspect: 4 / 5; }
    .guest-item[data-extra], .guest-more, .head-link { display: none; }
    .guests-all { display: flex; }
    .mobile-more { display: block; }
    .facts { grid-template-columns: 1fr 1fr; gap: var(--space-5) var(--space-4); margin-top: var(--space-7); }
    .floor { height: 40%; }
  }
</style>
