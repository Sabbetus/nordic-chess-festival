---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Schedule from '../../components/Schedule.astro';
import { localeStaticPaths, messages } from '../../i18n/utils';
import { venue } from '../../data/schedule';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props;
const m = messages[lang];
const t = m.mainEvent;

const regs = await getEntry('regulations', lang);
const { Content, headings } = await render(regs!);
const toc = headings.filter((h) => h.depth === 2);

const cards: { title: string; rows: string[][] }[] = [
  {
    title: t.eventCard,
    rows: [
      [t.details.dates, m.common.dates],
      [t.details.venue, `${venue.name}, ${venue.street}, ${venue.city}`],
      [t.details.format, t.values.format],
      [t.details.prizePool, t.values.prizePool],
      [t.details.timeControl, t.values.timeControl],
    ],
  },
  {
    title: t.rulesCard,
    rows: [
      [t.details.pairings, t.values.pairings],
      [t.details.rating, t.values.rating],
      [t.details.arbiters, 'IA Eetu Tiiva'],
      [t.details.organiser, 'Henry Brade'],
    ],
  },
];
---

<BaseLayout lang={lang} path="/main-event/" title={t.title} description={t.lead}>
  <PageHero eyebrow={`${m.common.place} · ${m.common.dates}`} title={t.title} lead={t.lead} />

  <section class="section">
    <div class="container">
      <h2>{t.detailsTitle}</h2>
      <div class="info-grid">
        {cards.map((c) => (
          <section class="info-card">
            <h3>{c.title}</h3>
            <dl>
              {c.rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
            </dl>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="schedule">
    <div class="container">
      <div class="schedule-block">
        <div class="section-head schedule-head">
          <h2>{t.scheduleTitle}</h2>
          <p class="muted small">{t.scheduleNote}</p>
        </div>
        <Schedule lang={lang} />
        <div class="notice warn"><p>{t.confirmationWarning}</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="regulations">
    <div class="container">
      <div class="section-head">
        <h2>{t.regulationsTitle}</h2>
      </div>
      {regs!.data.preliminary && <p class="notice-line">{t.preliminary}</p>}
      <div class="regs">
        <nav class="toc" aria-label={t.regulationsTitle}>
          <ul>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </nav>
        <div class="prose regs-body"><Content /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The schedule does not need the full page width: a narrower block reads better. */
  .schedule-block { max-width: 44rem; }
  .schedule-head { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-5); align-items: stretch; }
  .info-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--box-pad); position: relative; }
  .info-card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--ice), transparent); opacity: 0.6; }
  .info-card h3 { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); margin-bottom: var(--space-3); }
  .info-card dl > div { display: grid; grid-template-columns: 9.5rem 1fr; gap: var(--space-4); padding-block: var(--space-3); border-top: 1px solid var(--line); align-items: baseline; }
  dt { font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  dd { font-family: var(--font-body); font-size: 1.05rem; font-weight: 400; line-height: 1.5; color: var(--white); }
  @media (max-width: 520px) { .info-card dl > div { grid-template-columns: 1fr; gap: 0.2rem; } }
  .small { font-size: var(--text-sm); }
  .warn { margin-top: var(--space-5); }
  .notice-line { color: var(--muted); border-left: 2px solid var(--ice); padding-left: var(--space-4); margin-bottom: var(--space-6); max-width: 44rem; }
  .regs { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: var(--space-7); align-items: start; }
  .toc { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .toc ul { list-style: none; display: grid; gap: var(--space-2); border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 0.2rem 0 0.2rem var(--space-4); margin-left: -1px; border-left: 1px solid transparent; font-size: var(--text-sm); color: var(--muted); }
  .toc a:hover { color: var(--ice); border-left-color: var(--ice); }
  .regs-body { max-width: 46rem; }
  .regs-body :global(h2) { font-size: 2rem; margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .regs-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .regs-body :global(p + ul), .regs-body :global(p + ol) { margin-top: var(--space-3); }
  .regs-body :global(ul), .regs-body :global(ol) { margin-top: var(--space-3); }
  .regs-body :global(strong) { color: var(--white); font-weight: 500; }
  @media (max-width: 900px) { .info-grid { grid-template-columns: 1fr; } .regs { grid-template-columns: 1fr; gap: var(--space-5); } .toc { position: static; } .toc ul { grid-template-columns: 1fr 1fr; border-left: 0; } .toc a { padding-left: 0; } }
</style>
