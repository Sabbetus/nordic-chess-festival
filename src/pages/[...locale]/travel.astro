---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { localePath, localeStaticPaths, messages } from "../../i18n/utils";
import { venue } from "../../data/schedule";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
const t = m.travel;

// Hotel booking details. The online code (with the B) is the main way to book; the quota code is for phone and email.
const hotel = {
  site: 'https://www.sokoshotels.fi',
  onlineCode: 'BNORDICCHESS',
  quotaCode: 'NORDICCHESS',
  phone: '+358 300 870 000',
  phoneHref: 'tel:+358300870000',
  email: 'sokos.hotels@sok.fi',
};
const [phoneBefore, phoneAfter] = t.phoneText.split('{code}');
---

<BaseLayout lang={lang} path="/travel/" title={t.title} description={t.lead}>
  <PageHero eyebrow={m.common.place} title={t.title} lead={t.lead} />

  <section class="section" id="stay">
    <div class="container">
      <div class="head">
        <h2>{t.stayTitle}</h2>
        <p class="lead">{t.stayLead}</p>
      </div>

      <div class="stay-grid">
        <article class="book">
          <h3>{t.onlineTitle}</h3>
          <p class="label">{t.codeLabel}</p>
          <div class="code-row">
            <code class="code" id="booking-code">{hotel.onlineCode}</code>
            <button class="btn btn-ghost btn-sm" type="button" data-copy="booking-code" data-copied={t.copied}>{t.copy}</button>
          </div>
          <p class="muted">{t.onlineText}</p>
          <p class="btn-row"><a class="btn btn-primary" href={hotel.site} target="_blank" rel="noopener">{t.onlineCta} <span class="arrow" aria-hidden="true">→</span></a></p>
        </article>

        <div class="hotels">
          {t.hotels.map((h) => (
            <article class="hotel">
              <h3>{h.name}</h3>
              <dl>
                {h.rooms.map(([room, price]) => <div><dt>{room}</dt><dd>{price}</dd></div>)}
              </dl>
            </article>
          ))}
          <p class="muted rates">{t.ratesNote}</p>
        </div>
      </div>

      <div class="phone-box">
        <h3>{t.phoneTitle}</h3>
        <p>{phoneBefore}<strong>{hotel.quotaCode}</strong>{phoneAfter}</p>
        <p class="contact"><span>{t.phoneLabel}: <a href={hotel.phoneHref}>{hotel.phone}</a></span> <span>{t.emailLabel}: <a href={`mailto:${hotel.email}`}>{hotel.email}</a></span></p>
      </div>
    </div>
  </section>

  <section class="section" id="getting-there">
    <div class="container">
      <div class="head"><h2>{t.gettingThereTitle}</h2></div>
      <div class="two">
        <article class="card">
          <h3>{t.venueTitle}</h3>
          <p>{t.venueText}</p>
          <p class="addr">{venue.name}<br />{venue.street}, {venue.city}, {venue.country}</p>
          <p><a href={venue.mapUrl} target="_blank" rel="noopener">{t.viewOnMap} →</a></p>
        </article>
        <article class="card">
          <h3>{t.busTitle}</h3>
          <p>{t.busText}</p>
          <p class="timetable">{t.busTimetable}</p>
          <p><a href={localePath(lang, '/register/#register')}>{t.busCta} →</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card visa">
        <h3>{t.visaTitle}</h3>
        <p>{t.visaText}</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .head { display: grid; gap: var(--space-3); margin-bottom: var(--space-5); }
  .head .lead { max-width: 46rem; }
  .muted { color: var(--muted); font-size: var(--text-sm); }

  .stay-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-5); align-items: stretch; }
  .book, .hotel, .card, .phone-box {
    position: relative; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); padding: var(--space-5) var(--space-6);
  }
  .book { border-color: var(--ice-border); background: linear-gradient(160deg, var(--ice-dim), var(--surface) 70%); display: grid; gap: var(--space-3); align-content: start; }
  .book::before, .hotel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--ice), transparent); opacity: 0.7; }
  h3 { font-size: 1.35rem; }
  .label { font-size: var(--text-xs); letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); }
  .code-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .code { font-family: var(--font-body); font-size: clamp(1.6rem, 3.2vw, 2.2rem); font-weight: 500; letter-spacing: 0.12em; color: var(--white); user-select: all; }
  .book .btn-row { margin-top: var(--space-2); }

  .hotels { display: grid; gap: var(--space-4); align-content: start; }
  .hotel { display: grid; gap: var(--space-3); padding-block: var(--space-4); }
  dl > div { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); border-top: 1px solid var(--line); }
  dt { color: var(--muted); }
  dd { color: var(--white); font-variant-numeric: lining-nums; white-space: nowrap; }
  .rates { margin-top: calc(var(--space-2) * -1); }

  .phone-box { margin-top: var(--space-5); display: grid; gap: var(--space-2); padding-block: var(--space-4); }
  .phone-box p { color: var(--muted); }
  .phone-box strong { color: var(--white); font-weight: 500; letter-spacing: 0.06em; }
  .contact { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .card { display: grid; gap: var(--space-3); align-content: start; }
  .addr { color: var(--white); }
  .timetable { color: var(--white); }
  .visa { max-width: 46rem; }

  @media (max-width: 900px) {
    .stay-grid, .two { grid-template-columns: 1fr; }
    .book, .hotel, .card, .phone-box { padding: var(--space-4); }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy!)?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = btn.dataset.copied ?? label;
        setTimeout(() => (btn.textContent = label), 1800);
      } catch {
        /* the code is selectable, so copying by hand still works */
      }
    });
  });
</script>
