---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { localePath, localeStaticPaths, messages } from "../../i18n/utils";
import { Image } from "astro:assets";
import { venue } from "../../data/schedule";
import ilves from "../../assets/hotel-ilves.webp";
import torni from "../../assets/hotel-torni.jpg";
import areena from "../../assets/kangasala-areena.webp";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
const t = m.travel;

// Hotel booking details. The online code (with the B) is the main way to book; the quota code is for phone and email.
const hotel = {
  site: 'https://www.sokoshotels.fi',
  onlineCode: 'BNORDICCHESS',
  quotaCode: 'NORDICCHESS',
  phone: '+358 300 870 000',
  phoneHref: 'tel:+358300870000',
  email: 'sokos.hotels@sok.fi',
};
const [phoneBefore, phoneAfter] = t.phoneText.split('{code}');
// Photos, in the same order as the hotels in the translations. The Torni photo is a portrait, so it is cropped from the top.
const hotelPhotos: { src: ImageMetadata; position: string; credit?: { text: string; url: string } }[] = [
  { src: ilves, position: '50% 30%' },
  {
    src: torni,
    position: '50% 2%',
    credit: { text: 'Cryonic07, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Hotel_Tampere_Torni_2016_03_14_cropped.jpg' },
  },
];
---

<BaseLayout lang={lang} path="/travel/" title={t.title} description={t.lead}>
  <PageHero eyebrow={m.common.place} title={t.title} lead={t.lead} />

  <section class="section" id="stay">
    <div class="container">
      <div class="head">
        <h2>{t.stayTitle}</h2>
        <p class="lead">{t.stayLead}</p>
      </div>

      <article class="book">
          <h3>{t.onlineTitle}</h3>
          <p class="label">{t.codeLabel}</p>
          <div class="code-row">
            <code class="code" id="booking-code">{hotel.onlineCode}</code>
            <button class="btn btn-ghost btn-sm" type="button" data-copy="booking-code" data-copied={t.copied}>{t.copy}</button>
          </div>
          <p class="muted">{t.onlineText}</p>
          <p class="btn-row"><a class="btn btn-primary" href={hotel.site} target="_blank" rel="noopener">{t.onlineCta} <span class="arrow" aria-hidden="true">→</span></a></p>
      </article>

      <div class="hotels">
        {t.hotels.map((h, i) => (
          <article class="hotel">
            <div class="photo">
              <Image src={hotelPhotos[i].src} alt={h.name} widths={[500, 800, 1100]} sizes="(min-width: 900px) 580px, 100vw" quality={85} style={`object-position: ${hotelPhotos[i].position}`} />
              {hotelPhotos[i].credit && <a class="credit" href={hotelPhotos[i].credit!.url} target="_blank" rel="noopener">{m.common.photoCredit}: {hotelPhotos[i].credit!.text}</a>}
            </div>
            <div class="body">
              <h3>{h.name}</h3>
              <dl>
                {h.rooms.map(([room, price]) => <div><dt>{room}</dt><dd>{price}</dd></div>)}
              </dl>
            </div>
          </article>
        ))}
      </div>
      <p class="muted rates">{t.ratesNote}</p>

      <div class="phone-box">
        <h3>{t.phoneTitle}</h3>
        <p>{phoneBefore}<strong>{hotel.quotaCode}</strong>{phoneAfter}</p>
        <p class="contact"><span>{t.phoneLabel}: <a href={hotel.phoneHref}>{hotel.phone}</a></span> <span>{t.emailLabel}: <a href={`mailto:${hotel.email}`}>{hotel.email}</a></span></p>
      </div>
    </div>
  </section>

  <section class="section" id="getting-there">
    <div class="container">
      <div class="head"><h2>{t.gettingThereTitle}</h2></div>
      <div class="two">
        <article class="card has-photo">
          <div class="photo">
            <Image src={areena} alt={t.venueAlt} widths={[500, 800, 1000]} sizes="(min-width: 900px) 580px, 100vw" quality={85} />
          </div>
          <div class="body">
            <h3>{t.venueTitle}</h3>
            <p>{t.venueText}</p>
            <p class="addr">{venue.name}<br />{venue.street}, {venue.city}, {venue.country}</p>
            <p><a href={venue.mapUrl} target="_blank" rel="noopener">{t.viewOnMap} →</a></p>
          </div>
        </article>
        <div class="col">
          <article class="card">
            <h3>{t.busTitle}</h3>
            <p>{t.busText}</p>
            <p class="timetable">{t.busTimetable}</p>
            <p><a href={localePath(lang, '/register/#register')}>{t.busCta} →</a></p>
          </article>
          <article class="card">
            <h3>{t.localTitle}</h3>
            <p>{t.localText}</p>
            <p><a href={lang === 'fi' ? 'https://www.nysse.fi' : 'https://www.nysse.fi/en'} target="_blank" rel="noopener">{t.localCta} →</a></p>
          </article>
          <article class="card">
            <h3>{t.parkingTitle}</h3>
            <p>{t.parkingText}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card visa">
        <h3>{t.visaTitle}</h3>
        <p>{t.visaText}</p>
        <ul class="visa-links">
          {t.visaLinks.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener">{label} →</a></li>)}
        </ul>
        <p>{t.visaInvitation}</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .head { display: grid; gap: var(--space-3); margin-bottom: var(--space-5); }
  .head .lead { max-width: 46rem; }
  .muted { color: var(--muted); font-size: var(--text-sm); }

  .book, .hotel, .card, .phone-box {
    position: relative; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); padding: var(--box-pad);
  }
  .book { border-color: var(--ice-border); background: linear-gradient(160deg, var(--ice-dim), var(--surface) 70%); display: grid; gap: var(--space-3); align-content: start; margin-bottom: var(--space-5); }
  .book::before, .hotel::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--ice), transparent); opacity: 0.7; }
  h3 { font-size: 1.35rem; }
  .label { font-size: var(--text-xs); letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); }
  .code-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .code { font-family: var(--font-body); font-size: clamp(1.6rem, 3.2vw, 2.2rem); font-weight: 500; letter-spacing: 0.12em; color: var(--white); user-select: all; }
  .book .btn-row { margin-top: var(--space-2); }

  .hotels { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .hotel, .card.has-photo { padding: 0; overflow: hidden; display: flex; flex-direction: column; gap: 0; }
  .photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface-2); }
  .credit { position: absolute; right: 0.5rem; bottom: 0.5rem; font-size: 0.65rem; letter-spacing: 0.04em; color: var(--white); background: rgba(10, 10, 10, 0.6); padding: 0.15rem 0.5rem; border-radius: 3px; }
  .credit:hover { color: var(--ice); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: var(--box-pad); display: grid; gap: var(--space-3); align-content: start; }
  .has-photo .photo { aspect-ratio: 3 / 2; }
  dl > div { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); border-top: 1px solid var(--line); }
  dt { color: var(--muted); }
  dd { color: var(--white); font-variant-numeric: lining-nums; white-space: nowrap; }
  .rates { margin-top: var(--space-3); }

  .phone-box { margin-top: var(--space-5); display: grid; gap: var(--space-2); }
  .phone-box p { color: var(--muted); }
  .phone-box strong { color: var(--white); font-weight: 500; letter-spacing: 0.06em; }
  .contact { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }

  .col { display: grid; gap: var(--space-5); align-content: start; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); align-items: start; }
  .card { display: grid; gap: var(--space-3); align-content: start; hyphens: manual; overflow-wrap: normal; text-align: left; }
  .card h3 { font-size: 1.35rem; margin: 0; }
  .card .addr, .card .timetable { color: var(--white); }
  .addr { color: var(--white); }
  .timetable { color: var(--white); }
  .visa { max-width: 46rem; }
  .visa-links { list-style: none; display: grid; gap: var(--space-2); }

  @media (max-width: 900px) {
    .hotels, .two { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy!)?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = btn.dataset.copied ?? label;
        setTimeout(() => (btn.textContent = label), 1800);
      } catch {
        /* the code is selectable, so copying by hand still works */
      }
    });
  });
</script>
