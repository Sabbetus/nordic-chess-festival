---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { localeStaticPaths, messages } from "../../i18n/utils";
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props;
const m = messages[lang];
import { venue } from "../../data/schedule";
const t = m.travel;
const blocks = [
  [t.venueTitle, t.venueText],
  [t.gettingThereTitle, t.gettingThereText],
  [t.stayTitle, t.stayText],
  [t.visaTitle, t.visaText],
];
---

<BaseLayout lang={lang} path="/travel/" title={t.title} description={t.lead}>
  <PageHero eyebrow={m.common.place} title={t.title} lead={t.lead} />
  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {blocks.map(([title, text], i) => (
          <div class="card">
            <h3>{title}</h3>
            <p>{text}</p>
            {i === 0 && (
              <>
                <p class="addr">{venue.name}<br />{venue.street}, {venue.city}, {venue.country}</p>
                <p><a href={venue.mapUrl} target="_blank" rel="noopener">{t.viewOnMap} →</a></p>
              </>
            )}
          </div>
        ))}
      </div>
      <p class="note"><span class="placeholder-note">{m.common.placeholder}</span></p>
    </div>
  </section>
</BaseLayout>

<style>
  .note { margin-top: var(--space-5); }
  .addr { color: var(--white); margin-top: var(--space-3); }
  .card p + p { margin-top: var(--space-3); }
</style>
