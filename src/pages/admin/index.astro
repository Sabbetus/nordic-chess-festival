---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" path="/admin/" title="Organiser registrations" noindex>
  <section class="section">
    <div class="container admin stack">
      <h1>Registrations</h1>
      <form data-login class="login">
        <label for="tok">Organiser access key</label>
        <input id="tok" type="password" autocomplete="off" required />
        <button class="btn btn-primary" type="submit">Open</button>
        <p class="err" data-login-err></p>
      </form>
      <div class="panel" data-panel hidden>
        <p class="banner" data-fide hidden></p>
        <div class="bar">
          <label class="check"><input type="checkbox" data-all /> Show unpaid attempts too</label>
          <button class="btn btn-ghost btn-sm" type="button" data-refresh>Refresh</button>
          <button class="btn btn-primary btn-sm" type="button" data-csv>Download CSV</button>
          <span data-count class="muted"></span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Registered</th><th>Name</th><th>Fed</th><th>FIDE ID</th><th>Title</th><th>Rating</th><th>Born</th><th>Contact</th><th>Bus</th><th>Paid</th><th>Status</th><th>Note</th><th></th></tr>
            </thead>
            <tbody data-rows></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .admin { max-width: none; padding-inline: var(--space-5); }
  h1 { font-size: var(--text-h2-lg); }
  .login { display: grid; gap: var(--space-3); max-width: 24rem; }
  .login input { background: var(--black); color: var(--white); border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 0.8rem; font: inherit; }
  .err { color: var(--danger); }
  .bar { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; margin-bottom: var(--space-4); }
  .bar label { display: inline-flex; gap: var(--space-2); align-items: center; font-size: var(--text-sm); cursor: pointer; }
  .bar input { accent-color: var(--ice); }
  .muted { color: var(--muted); font-size: var(--text-sm); }
  .banner { border: 1px solid var(--ice-border); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4); font-size: var(--text-sm); }
  .banner.stale { border-color: var(--danger); color: var(--danger); }

  /* Rows are created by script, so their styles are global. */
  .panel :global(th), .panel :global(td) { padding: 0.6rem 0.65rem; font-size: var(--text-sm); vertical-align: middle; }
  .panel :global(td.wrap) { white-space: normal; min-width: 12rem; }
  .panel :global(tr.removed td) { opacity: 0.55; }
  .panel :global(.status-accepted) { color: var(--ice); }
  .panel :global(.status-rejected) { color: var(--danger); }

  /* Text boxes look like plain text until clicked, then become editable. */
  .panel :global(input.cell) {
    width: 10rem; margin-left: -0.55rem; background: transparent; color: var(--white); border: 1px solid transparent; border-radius: 4px;
    padding: 0.4rem 0.5rem; font: inherit; font-size: var(--text-sm); cursor: pointer;
  }
  .panel :global(input.cell.note) { width: 10rem; color: var(--muted); }
  .panel :global(input.cell:read-only:hover) { border-color: var(--line-strong); }
  .panel :global(input.cell:not(:read-only)) { background: var(--black); border-color: var(--ice); cursor: text; outline: none; }
  .panel :global(.actions) { display: flex; gap: var(--space-2); }
  .panel :global(.actions .btn) { padding: 0.5rem 0.7rem; letter-spacing: 0.08em; }
  .panel :global(.btn.danger:hover) { border-color: var(--danger); color: var(--danger); }
</style>

<script>
  // The key lives only in memory: reloading the page asks for it again, and nothing is written to browser storage.
  type Row = {
    id: string; created_at: string; name: string; email: string; phone: string; fide_id: string | null; title: string | null; rating: number | null;
    birth_year: number; federation: string; bus: number; total_cents: number; payment_status: string; review_status: string; note: string | null;
  };
  let key = '';
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const api = (path: string, init: RequestInit = {}) => fetch(path, { ...init, cache: 'no-store', headers: { ...(init.headers ?? {}), authorization: `Bearer ${key}` } });
  const cell = (tr: HTMLElement, text: string, cls = '') => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; tr.append(td); return td; };

  /** A text box that reads as plain text until it is clicked; it locks again if left unchanged. */
  function editable(value: string, className: string, label: string, placeholder = '') {
    const input = document.createElement('input');
    input.value = value; input.className = className; input.readOnly = true; input.placeholder = placeholder; input.setAttribute('aria-label', label);
    input.addEventListener('click', () => { input.readOnly = false; input.focus(); });
    input.addEventListener('blur', () => { if (input.value === value) input.readOnly = true; });
    return input;
  }

  async function load() {
    const all = $<HTMLInputElement>('[data-all]').checked;
    const res = await api(`/api/admin/registrations${all ? '?include=all' : ''}`);
    if (res.status === 401 || res.status === 503) throw new Error(res.status === 401 ? 'Wrong access key.' : 'The organiser interface is not set up yet.');
    const { registrations } = (await res.json()) as { registrations: Row[] };
    const body = $('[data-rows]');
    body.replaceChildren();
    for (const r of registrations) {
      const tr = document.createElement('tr');
      cell(tr, r.created_at.slice(0, 10));
      const nameInput = editable(r.name, 'cell', `Name of ${r.name}`);
      cell(tr, '').append(nameInput);
      cell(tr, r.federation);
      cell(tr, r.fide_id ?? '—');
      cell(tr, r.title ?? '');
      cell(tr, r.rating ? String(r.rating) : '');
      cell(tr, String(r.birth_year));
      cell(tr, `${r.email} ${r.phone}`, 'wrap');
      cell(tr, r.bus ? 'yes' : '');
      cell(tr, r.payment_status === 'not_required' ? 'free' : `${r.total_cents / 100} € ${r.payment_status}`);
      const note = editable(r.note ?? '', 'cell note', `Note for ${r.name}`, 'add a note');
      const removed = r.review_status === 'rejected';
      if (removed) tr.className = 'removed';
      cell(tr, removed ? 'Removed' : 'Accepted', removed ? 'status-rejected' : 'status-accepted');
      cell(tr, '').append(note);
      const actions = document.createElement('div');
      actions.className = 'actions';
      cell(tr, '').append(actions);
      for (const [status, label] of removed ? [['accepted', 'Restore'], ['rejected', 'Save']] as const : [['rejected', 'Remove'], ['accepted', 'Save']] as const) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = `btn btn-ghost btn-sm${label === 'Remove' ? ' danger' : ''}`; b.textContent = label;
        b.addEventListener('click', async () => {
          if (label === 'Remove' && !confirm(`Remove ${r.name} from the entry list? This does not refund the payment: refund in Stripe if needed.`)) return;
          b.disabled = true;
          await api(`/api/admin/registrations/${encodeURIComponent(r.id)}`, { method: 'POST', body: JSON.stringify({ review_status: status, note: note.value, name: nameInput.value }) });
          await load().catch(() => {});
        });
        actions.append(b);
      }
      body.append(tr);
    }
    $('[data-count]').textContent = `${registrations.length} shown`;
  }

  async function showFideAge() {
    const banner = $('[data-fide]');
    try {
      const { fideList } = (await (await fetch('/api/health', { cache: 'no-store' })).json()) as { fideList: string | null };
      banner.hidden = false;
      if (!fideList) { banner.textContent = 'FIDE rating list: not available. Registrations use the ratings players declare. Check the monthly refresh.'; banner.classList.add('stale'); return; }
      const days = Math.floor((Date.now() - Date.parse(fideList)) / 86_400_000);
      banner.textContent = `FIDE rating list from ${fideList} (${days} days old).`;
      if (days > 40) { banner.textContent += ' Older than a month: the automatic refresh has not worked, check it.'; banner.classList.add('stale'); }
    } catch { /* the banner is only a convenience */ }
  }

  $('[data-login]').addEventListener('submit', async (e) => {
    e.preventDefault();
    key = $<HTMLInputElement>('#tok').value.trim();
    $('[data-login-err]').textContent = '';
    try {
      await load();
      $('[data-login]').hidden = true;
      $('[data-panel]').hidden = false;
      showFideAge();
    } catch (err) {
      key = '';
      $('[data-login-err]').textContent = err instanceof Error ? err.message : 'Failed.';
    }
  });
  $('[data-refresh]').addEventListener('click', () => load().catch(() => {}));
  $('[data-all]').addEventListener('change', () => load().catch(() => {}));
  $('[data-csv]').addEventListener('click', async () => {
    const all = $<HTMLInputElement>('[data-all]').checked;
    const res = await api(`/api/admin/registrations?format=csv${all ? '&include=all' : ''}`);
    if (!res.ok) return;
    const url = URL.createObjectURL(await res.blob());
    const a = Object.assign(document.createElement('a'), { href: url, download: 'registrations.csv' });
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
