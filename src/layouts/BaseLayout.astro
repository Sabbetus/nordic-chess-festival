---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, defaultLocale, localePath, messages, type Locale } from '../i18n/utils';
import { rules } from '../data/fees';

interface Props {
  lang: Locale;
  /** Path without locale prefix, e.g. "/tournament/". */
  path: string;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { lang, path, title, description, image = '/preview.jpg', noindex = false, jsonLd } = Astro.props;
const m = messages[lang];
const pageTitle = title ? `${title} | ${m.meta.siteName} 2027` : m.meta.title;
const pageDescription = description ?? m.meta.description;
const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
const imageUrl = new URL(image, site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Finnish midnight after the deadline day (UTC+2 in winter).
const earlyBirdEnds = `${rules.earlyBirdDeadline}T23:59:59+02:00`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0a0a0a" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, path), site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/cormorant-garamond-v21-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-v17-latin-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-v17-latin-regular.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={m.meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Hides early bird prices once the deadline has passed, even without a rebuild. -->
    <script is:inline define:vars={{ earlyBirdEnds }}>
      if (Date.now() > Date.parse(earlyBirdEnds)) document.documentElement.classList.add('early-bird-over');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{m.common.skipToContent}</a>
    <Header lang={lang} path={path} />
    <main id="main" style="position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </body>
</html>
