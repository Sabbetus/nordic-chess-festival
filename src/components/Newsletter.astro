---
import { site } from '../data/site';
import { messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const n = messages[lang].home.newsletter;
---

<section class="section newsletter">
  <div class="container narrow">
    <h2>{n.title}</h2>
    <p class="lead">{n.text}</p>
    <p class="btn-row">
      <a class="btn btn-primary" href={site.newsletterUrl} target="_blank" rel="noopener">{n.cta} <span class="arrow" aria-hidden="true">→</span></a>
    </p>
    <p class="note">{n.note}</p>
  </div>
</section>

<style>
  .newsletter { position: relative; overflow: hidden; text-align: center; border-top: 1px solid var(--line); }
  .newsletter::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(50% 70% at 50% 100%, rgba(126, 200, 227, 0.14), transparent 70%);
  }
  .newsletter .container { display: grid; justify-items: center; gap: var(--space-5); }
  .newsletter h2 { font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .newsletter .lead { margin-inline: auto; }
  .newsletter .btn-row { justify-content: center; }
  .note { font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); }
</style>
