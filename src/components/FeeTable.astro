---
import { bands, formatEuro } from '../data/fees';
import { messages, type Locale } from '../i18n/utils';
import { localizeTitles } from '../lib/titles';

interface Props { lang: Locale }
const { lang } = Astro.props;
const m = messages[lang].register;
const price = (n: number) => (n === 0 ? m.free : formatEuro(n));
const label = (id: string, fallback: string) => (id === 'unrated' ? m.unrated : localizeTitles(lang, fallback));
---

<div class="table-wrap fees">
  <table>
    <thead>
      <tr>
        <th scope="col">{m.colRating}</th>
        <th scope="col" class="col-num">{m.colRegular}</th>
        <th scope="col" class="col-num" data-early-bird>
          {m.colEarly}
          <button class="info" type="button" aria-label={m.colEarlyNote} aria-expanded="false" aria-controls="fee-note" data-note={m.colEarlyNote}>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" /><path d="M10 9v5" /><circle cx="10" cy="6.2" r="0.6" fill="currentColor" /></svg>
          </button>
          <small>{m.colEarlyNote}</small>
        </th>
        <th scope="col" class="col-num">
          {m.colDiscount}
          <button class="info" type="button" aria-label={m.colDiscountNote} aria-expanded="false" aria-controls="fee-note" data-note={m.colDiscountNote}>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" /><path d="M10 9v5" /><circle cx="10" cy="6.2" r="0.6" fill="currentColor" /></svg>
          </button>
          <small>{m.colDiscountNote}</small>
        </th>
      </tr>
      <tr class="note-row" id="fee-note" hidden>
        <td colspan="4" data-note-text></td>
      </tr>
    </thead>
    <tbody>
      {bands.map((b) => (
        <tr>
          <th scope="row">{label(b.id, b.label)}</th>
          <td class="col-num">{price(b.regular)}</td>
          <td class="col-num accent" data-early-bird>{price(b.discounted)}</td>
          <td class="col-num accent">{price(b.discounted)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* Desktop: the table is only as wide as its content (not the whole page), and the explanations stay on one line. */
  .fees { width: fit-content; max-width: 100%; }
  .fees table { width: auto; }
  .fees th, .fees td { padding: 0.9rem 1.6rem; }
  .fees thead th small { white-space: nowrap; }
  .info, .note-row { display: none; }
  td { font-family: var(--font-body); font-weight: 500; font-size: 1.05rem; }
  td.accent { color: var(--ice); }

  /* Phones: the explanations become info icons (tap one to read it under the headings), so the table fits the screen
     without scrolling sideways, edge to edge, borrowing the page margins. */
  @media (max-width: 640px) {
    .fees { width: auto; max-width: none; margin-inline: calc(var(--gutter) * -1); border-inline: 0; border-radius: 0; }
    .fees table { width: 100%; }
    .fees th, .fees td { padding: 0.75rem 0.5rem; }
    .fees th:first-child, .fees td:first-child { padding-left: 0.85rem; }
    .fees th:last-child, .fees td:last-child { padding-right: 0.85rem; }
    .fees thead th { white-space: normal; font-size: 0.8rem; letter-spacing: 0; line-height: 1.25; hyphens: auto; overflow-wrap: break-word; }
    .fees thead th small { display: none; }
    .info {
      display: inline-grid; place-items: center; vertical-align: -0.2em; margin-left: 0.2rem; padding: 0.25rem; margin-block: -0.25rem;
      background: none; border: 0; border-radius: 50%; color: var(--ice); cursor: pointer;
    }
    .info[aria-expanded='true'] { background: var(--ice-dim); }
    .fees thead .note-row:not([hidden]) { display: table-row; }
    .note-row td {
      padding: 0.6rem 0.85rem; background: var(--ice-dim); border-top: 1px solid var(--ice-border); border-bottom: 1px solid var(--ice-border);
      font-family: var(--font-body); font-weight: 300; font-size: 0.78rem; letter-spacing: 0; color: var(--ice); text-align: left; white-space: normal;
    }
    td { font-size: 0.95rem; }
    .fees tbody th { font-size: 0.9rem; }
  }
  @media (max-width: 400px) {
    .fees th, .fees td { padding-inline: 0.3rem; }
    .fees th:first-child, .fees td:first-child { padding-left: 0.65rem; }
    .fees th:last-child, .fees td:last-child { padding-right: 0.65rem; }
    .fees thead th { font-size: 0.7rem; }
    .fees tbody th, td { font-size: 0.86rem; }
  }
  @media (max-width: 340px) {
    .fees thead th { font-size: 0.62rem; }
    .info { margin-left: 0; }
    .fees tbody th, td { font-size: 0.8rem; }
  }
</style>

<script>
  // Phones: tapping an info icon shows its explanation under the headings; tapping it again (or the other one) switches.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.fees .info');
  const row = document.getElementById('fee-note');
  const text = row?.querySelector<HTMLElement>('[data-note-text]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!row || !text) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      row.hidden = open;
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        text.textContent = btn.dataset.note ?? '';
      }
    }),
  );
</script>
