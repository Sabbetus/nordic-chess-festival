---
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';
import { federationOptions } from '../data/federations';
import { busTransfer, formatEuro } from '../data/fees';
import { titles } from '../lib/registration';
import { localePath, messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const f = messages[lang].register.form;

const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
const phoneCodes = getCountries()
  .map((c) => ({ code: c, label: `${regionNames.of(c) ?? c} (+${getCountryCallingCode(c)})` }))
  .sort((a, b) => a.label.localeCompare(b.label, lang));
const federations = federationOptions(lang);
const busHelp = f.busHelp.replace('{price}', formatEuro(busTransfer.price));
const [acceptA, acceptB] = f.accept.split('{regulations}');
const [acceptC, acceptD] = acceptB.split('{refunds}');
const [acceptE, acceptF] = acceptD.split('{privacy}');
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const ui = {
  lang, bus: busTransfer.price, free: f.free, reasons: f.reasons, hint: f.summaryHint, earlyBirdNote: f.earlyBirdNote,
  gmNote: f.gmNote, unratedNote: f.unratedNote, submitPay: f.submitPay, submitFree: f.submitFree, sending: f.sending,
  errors: {
    name: f.errName, email: f.errEmail, phone: f.errPhone, fideId: f.errFideId, rating: f.errRating, birthYear: f.errBirthYear,
    federation: f.errFederation, accept: f.errAccept, required: f.errRequired,
  },
  errDuplicate: f.errDuplicate, errUnavailable: f.errUnavailable, errGeneric: f.errGeneric, errorSummary: f.errorSummary,
  thanks: localePath(lang, '/register/thanks/'),
  lookup: { checking: f.lookupChecking, found: f.lookupFound, foundNote: f.lookupFoundNote, notFound: f.lookupNotFound, unavailable: f.lookupUnavailable, list: f.lookupList, none: f.fideTitleNone },
};
---

<div data-register data-sitekey={sitekey} hidden>
  <noscript><p class="notice">{f.noscript}</p></noscript>
  <form class="reg" novalidate>
    <p class="intro">{f.intro}</p>
    <div class="error-summary" role="alert" data-summary hidden></div>

    <fieldset>
      <legend>{f.sectionChess}</legend>
      <div class="field" data-fide-id>
        <label for="f-fide">{f.fideId}</label>
        <input id="f-fide" name="fideId" inputmode="numeric" maxlength="10" autocomplete="off" class="short" />
        <p class="help">{f.fideIdHelp}</p><p class="err" data-err="fideId"></p>
      </div>
      <div class="lookup" data-lookup hidden aria-live="polite">
        <p class="lookup-status" data-lookup-status></p>
        <dl data-lookup-card hidden>
          <div><dt>{f.lookupName}</dt><dd data-l-name></dd></div>
          <div><dt>{f.lookupFederation}</dt><dd data-l-fed></dd></div>
          <div data-l-born-row><dt>{f.lookupBorn}</dt><dd data-l-born></dd></div>
          <div><dt>{f.lookupTitle}</dt><dd data-l-title></dd></div>
          <div><dt>{f.lookupRating}</dt><dd data-l-rating></dd></div>
        </dl>
        <p class="help" data-lookup-note></p>
      </div>
      <label class="check"><input type="checkbox" name="noFideId" /> <span>{f.noFideId}<small>{f.noFideIdHelp}</small></span></label>
    </fieldset>

    <fieldset>
      <legend>{f.sectionAbout}</legend>
      <div data-manual hidden>
        <div class="field">
          <label for="f-name">{f.nameManual}</label>
          <input id="f-name" name="name" autocomplete="name" maxlength="100" />
          <p class="help">{f.nameHelp}</p><p class="err" data-err="name"></p>
        </div>
        <div class="field">
          <label for="f-fed">{f.federation}</label>
          <select id="f-fed" name="federation">
            <option value="">{f.federationPlaceholder}</option>
            {federations.map((x) => <option value={x.code}>{x.label} ({x.code})</option>)}
          </select>
          <p class="err" data-err="federation"></p>
        </div>
      </div>
      <div class="field" data-birth hidden>
        <label for="f-birth">{f.birthYear}</label>
        <input id="f-birth" name="birthYear" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" class="short" />
        <p class="help">{f.birthYearHelp}</p><p class="err" data-err="birthYear"></p>
      </div>
      <div data-declared hidden>
        <div class="row">
          <div class="field">
            <label for="f-title">{f.fideTitle}</label>
            <select id="f-title" name="title">
              <option value="">{f.fideTitleNone}</option>
              {titles.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-rating">{f.rating}</label>
            <input id="f-rating" name="rating" inputmode="numeric" maxlength="4" class="short" />
            <p class="err" data-err="rating"></p>
          </div>
        </div>
        <p class="help">{f.ratingHelp}</p>
      </div>
      <div class="field">
        <label for="f-email">{f.email}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        <p class="help">{f.emailHelp}</p><p class="err" data-err="email"></p>
      </div>
      <div class="field">
        <label for="f-phone">{f.phone}</label>
        <div class="phone">
          <select name="phoneCountry" aria-label={f.phoneCountry} autocomplete="tel-country-code">
            {phoneCodes.map((c) => <option value={c.code} selected={c.code === 'FI'}>{c.label}</option>)}
          </select>
          <input id="f-phone" name="phoneNumber" type="tel" autocomplete="tel-national" required maxlength="30" />
        </div>
        <p class="help">{f.phoneHelp}</p><p class="err" data-err="phone"></p>
      </div>
    </fieldset>

    <fieldset>
      <legend>{f.sectionExtras}</legend>
      <label class="check"><input type="checkbox" name="bus" /> <span>{f.bus}<small>{busHelp}</small></span></label>
    </fieldset>

    <div class="summary" aria-live="polite">
      <h3>{f.summaryTitle}</h3>
      <p class="hint" data-hint>{f.summaryHint}</p>
      <dl data-lines hidden>
        <div><dt>{f.summaryEntry}<small data-reason></small></dt><dd data-entry></dd></div>
        <div data-bus-line hidden><dt>{f.summaryBus}</dt><dd data-bus></dd></div>
        <div class="total"><dt>{f.summaryTotal}</dt><dd data-total></dd></div>
      </dl>
      <p class="note" data-notes></p>
    </div>

    <div class="field hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>

    <div class="field accept">
      <label class="check">
        <input type="checkbox" name="accept" />
        <span>{acceptA}<a href={localePath(lang, '/main-event/#regulations')} target="_blank" rel="noopener">{f.regulationsLabel}</a>{acceptC}<a href="#refunds" >{f.refundsLabel}</a>{acceptE}<a href={localePath(lang, '/privacy/')} target="_blank" rel="noopener">{f.privacyLabel}</a>{acceptF}</span>
      </label>
      <p class="err" data-err="accept"></p>
    </div>

    <div class="turnstile" data-turnstile></div>
    <button class="btn btn-primary" type="submit" data-submit>{f.submitPay} <span class="arrow" aria-hidden="true">→</span></button>
    <p class="err form-err" data-form-err role="alert"></p>
  </form>
  <script type="application/json" id="reg-ui" set:html={JSON.stringify(ui)} />
</div>

<style>
  .reg { display: grid; gap: var(--space-6); max-width: 40rem; }
  .intro { color: var(--muted); }
  fieldset { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: var(--space-5) var(--space-6); display: grid; gap: var(--space-4); min-inline-size: 0; }
  legend { font-size: var(--text-xs); letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); padding-inline: var(--space-2); }
  .field { display: grid; gap: 0.4rem; min-inline-size: 0; }
  label { font-size: var(--text-sm); color: var(--white); }
  input:not([type='checkbox']), select {
    width: 100%; background: var(--black); color: var(--white); border: 1px solid var(--line-strong); border-radius: var(--radius);
    padding: 0.8rem 0.9rem; font: inherit; font-size: 1rem; min-height: 3rem;
  }
  input.short { max-width: 10rem; }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--ice); outline-offset: 1px; border-color: var(--ice); }
  .field.invalid input, .field.invalid select { border-color: var(--danger); }
  .phone { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-3); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .help { font-size: var(--text-xs); color: var(--muted-2); }
  .err { font-size: var(--text-sm); color: var(--danger); min-height: 0; }
  .err:empty { display: none; }
  .check { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; cursor: pointer; }
  .check input { width: 1.2rem; height: 1.2rem; margin-top: 0.15rem; accent-color: var(--ice); }
  .check small { display: block; color: var(--muted-2); font-size: var(--text-xs); margin-top: 0.25rem; line-height: 1.5; }
  [data-manual], [data-declared] { display: grid; gap: var(--space-4); }
  .lookup { display: grid; gap: var(--space-3); }
  .lookup-status { font-size: var(--text-sm); color: var(--muted); }
  .lookup.found .lookup-status { color: var(--ice); }
  .lookup dl { border: 1px solid var(--ice-border); background: var(--ice-dim); border-radius: var(--radius); padding: var(--space-3) var(--space-5); }
  .lookup dl > div { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); border-top: 1px solid var(--line); }
  .lookup dl > div:first-child { border-top: 0; }
  .lookup dt { font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); align-self: center; }
  .lookup dd { text-align: right; font-variant-numeric: lining-nums; }
  .summary { border: 1px solid var(--ice-border); border-radius: var(--radius); background: var(--ice-dim); padding: var(--space-5) var(--space-6); display: grid; gap: var(--space-3); }
  .summary h3 { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); }
  .summary dl > div { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); border-top: 1px solid var(--line); }
  .summary dt small { display: block; color: var(--muted); font-size: var(--text-xs); }
  .summary dd { font-variant-numeric: lining-nums; white-space: nowrap; }
  .summary .total { font-size: 1.25rem; color: var(--ice-bright); }
  .note, .hint { font-size: var(--text-sm); color: var(--muted); }
  .note:empty { display: none; }
  .error-summary { border: 1px solid var(--danger); border-radius: var(--radius); padding: var(--space-4); color: var(--danger); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .accept a { color: var(--ice); text-decoration: underline; }
  [data-submit][disabled] { opacity: 0.6; cursor: wait; }
  @media (max-width: 520px) { fieldset { padding: var(--space-4); } .phone, .row { grid-template-columns: 1fr; } input.short { max-width: none; } }
</style>

<script>
  import type { Title } from '../data/fees';
  import { quote, helsinkiToday } from '../lib/pricing';

  type UI = {
    lang: string; bus: number; free: string; reasons: Record<string, string>; hint: string; earlyBirdNote: string; gmNote: string;
    unratedNote: string; submitPay: string; submitFree: string; sending: string; errors: Record<string, string>;
    errDuplicate: string; errUnavailable: string; errGeneric: string; errorSummary: string; thanks: string;
    lookup: { checking: string; found: string; foundNote: string; notFound: string; unavailable: string; list: string; none: string };
  };
  type Lookup =
    | { status: 'found'; fideId: string; name: string; federation: string; title: string; rating: number; birthYear: number; updated: string }
    | { status: 'not_found'; updated: string }
    | { status: 'unavailable' };

  const root = document.querySelector<HTMLElement>('[data-register]');
  const openSoon = document.querySelector<HTMLElement>('[data-register-closed]');
  if (root) init(root);

  async function init(root: HTMLElement) {
    const loading = document.querySelector<HTMLElement>('[data-register-loading]');
    let open = false;
    try {
      const health = await fetch('/api/health', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null));
      open = Boolean(health?.registration);
      if (open) {
        const ui: UI = JSON.parse(document.getElementById('reg-ui')!.textContent!);
        root.hidden = false;
        start(root, ui, Boolean(health.turnstile));
      }
    } catch {
      /* API not reachable: show the "opens soon" notice. */
    }
    if (loading) loading.hidden = true;
    if (!open && openSoon) openSoon.hidden = false;
  }

  function start(root: HTMLElement, ui: UI, turnstile: boolean) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const euro = (cents: number) => `${cents / 100} €`;
    let token = '';

    if (turnstile && root.dataset.sitekey) {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => (window as any).turnstile.render($('[data-turnstile]'), { sitekey: root.dataset.sitekey, callback: (t: string) => (token = t), 'expired-callback': () => (token = '') });
      document.head.append(s);
    }

    // --- FIDE lookup: the only thing a player with a FIDE ID types is the ID itself ---
    let lookup: Lookup | null = null;
    let checking: Promise<void> = Promise.resolve();
    let seq = 0;

    const fedLabel = (code: string) => form.querySelector<HTMLOptionElement>(`select[name=federation] option[value="${code}"]`)?.textContent ?? code;

    function renderLookup() {
      const noFide = el('noFideId').checked;
      const L = lookup as Lookup | null;
      const box = $('[data-lookup]');
      const status = $('[data-lookup-status]');
      const card = $('[data-lookup-card]');
      const note = $('[data-lookup-note]');
      $('[data-fide-id]').hidden = noFide;
      const typed = el('fideId').value.trim();
      const showBox = !noFide && typed.length >= 3;
      box.hidden = !showBox;
      box.classList.toggle('found', L?.status === 'found');
      card.hidden = L?.status !== 'found';
      note.textContent = '';
      if (showBox) {
        if (!L) status.textContent = ui.lookup.checking;
        else if (L.status === 'found') {
          status.textContent = `${ui.lookup.found} · ${ui.lookup.list.replace('{date}', L.updated)}`;
          $('[data-l-name]').textContent = L.name;
          $('[data-l-fed]').textContent = fedLabel(L.federation);
          $('[data-l-born]').textContent = L.birthYear ? String(L.birthYear) : '';
          $<HTMLElement>('[data-l-born-row]').hidden = !L.birthYear;
          $('[data-l-title]').textContent = L.title || ui.lookup.none;
          $('[data-l-rating]').textContent = String(L.rating);
          note.textContent = ui.lookup.foundNote;
        } else status.textContent = L.status === 'not_found' ? ui.lookup.notFound : ui.lookup.unavailable;
      }
      // Fields the player must fill in only when FIDE does not supply them.
      const found = !noFide && L?.status === 'found';
      const manual = noFide || (showBox && !!L && !found);
      $('[data-manual]').hidden = !manual;
      $('[data-birth]').hidden = !(manual || (L?.status === 'found' && !noFide && !L.birthYear));
      $('[data-declared]').hidden = !(!noFide && L?.status === 'unavailable');
    }

    function onFideInput() {
      lookup = null;
      const id = el('fideId').value.trim();
      const mine = ++seq;
      if (el('noFideId').checked || !/^\d{3,10}$/.test(id)) { checking = Promise.resolve(); renderAll(); return; }
      checking = new Promise<void>((resolve) => {
        setTimeout(async () => {
          if (mine !== seq) return resolve();
          try {
            const res = await fetch(`/api/fide/${id}`, { cache: 'no-store' });
            const body = (await res.json()) as Lookup;
            if (mine === seq) lookup = res.ok ? body : { status: 'unavailable' };
          } catch {
            if (mine === seq) lookup = { status: 'unavailable' };
          }
          if (mine === seq) renderAll();
          resolve();
        }, 350);
      });
      renderAll();
    }

    // --- price ---
    const state = () => {
      const noFide = el('noFideId').checked;
      const L = lookup as Lookup | null;
      if (!noFide && L?.status === 'found') {
        return { by: L.birthYear || Number(el('birthYear').value.trim()), title: L.title as Title | '', rating: L.rating, bus: el('bus').checked, ready: true };
      }
      const declared = !noFide && L?.status === 'unavailable';
      const r = declared ? el('rating').value.trim() : '';
      const ready = noFide || L?.status === 'not_found' || declared;
      return { by: Number(el('birthYear').value.trim()), title: (declared ? el('title').value : '') as Title | '', rating: /^\d{3,4}$/.test(r) ? Number(r) : null, bus: el('bus').checked, ready };
    };

    function renderSummary() {
      const s = state();
      const valid = s.ready && s.by >= 1900 && s.by <= 2022;
      const lines = $('[data-lines]');
      $('[data-hint]').hidden = valid;
      lines.hidden = !valid;
      if (!valid) { $('[data-notes]').textContent = ''; setButton(false); return; }
      const q = quote({ title: s.title || null, rating: s.rating, birthYear: s.by, bus: s.bus }, helsinkiToday());
      $('[data-entry]').textContent = q.entryCents === 0 ? ui.free : euro(q.entryCents);
      $('[data-reason]').textContent = q.entryCents === 0 ? '' : (ui.reasons[q.fee.discount] ?? '');
      $('[data-bus-line]').hidden = !s.bus;
      $('[data-bus]').textContent = euro(q.busCents);
      $('[data-total]').textContent = q.totalCents === 0 ? ui.free : euro(q.totalCents);
      const notes: string[] = [];
      if (q.entryCents === 0) notes.push(ui.gmNote);
      if (q.fee.band.id === 'unrated') notes.push(ui.unratedNote);
      if (q.fee.discount === 'early-bird') notes.push(ui.earlyBirdNote);
      $('[data-notes]').textContent = notes.join(' ');
      setButton(q.totalCents === 0);
    }

    function setButton(free: boolean) {
      $<HTMLButtonElement>('[data-submit]').firstChild!.textContent = (free ? ui.submitFree : ui.submitPay) + ' ';
    }

    const renderAll = () => { renderLookup(); renderSummary(); };

    el('fideId').addEventListener('input', onFideInput);
    el('noFideId').addEventListener('change', onFideInput);
    form.addEventListener('input', renderSummary);
    form.addEventListener('change', renderSummary);
    renderAll();

    const clearErrors = () => {
      form.querySelectorAll('[data-err]').forEach((e) => (e.textContent = ''));
      form.querySelectorAll('.invalid').forEach((e) => e.classList.remove('invalid'));
      $('[data-summary]').hidden = true;
      $('[data-form-err]').textContent = '';
    };
    const showErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [field, kind] of Object.entries(errors)) {
        const slot = form.querySelector<HTMLElement>(`[data-err="${field}"]`);
        if (!slot) continue;
        slot.textContent = kind === 'required' && field !== 'accept' ? ui.errors.required : ui.errors[field];
        const wrap = slot.closest('.field');
        wrap?.classList.add('invalid');
        first ??= wrap?.querySelector<HTMLElement>('input, select') ?? null;
      }
      const summary = $('[data-summary]');
      summary.textContent = ui.errorSummary;
      summary.hidden = false;
      first?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      await checking;
      const noFide = el('noFideId').checked;
      const L = lookup as Lookup | null;
      const found = !noFide && L?.status === 'found';
      const declared = !noFide && L?.status === 'unavailable';
      // With a FIDE record the server takes everything from FIDE; the browser sends only the ID and contact details.
      const data = {
        email: el('email').value, phoneCountry: el('phoneCountry').value, phoneNumber: el('phoneNumber').value,
        noFideId: noFide, fideId: noFide ? '' : el('fideId').value,
        name: found ? '' : el('name').value, federation: found ? '' : el('federation').value,
        birthYear: found && L?.status === 'found' && L.birthYear ? '' : el('birthYear').value,
        title: declared ? el('title').value : '', rating: declared ? el('rating').value : '',
        bus: el('bus').checked, accept: el('accept').checked, locale: ui.lang, website: el('website').value, turnstile: token,
      };
      const button = $<HTMLButtonElement>('[data-submit]');
      const label = button.firstChild!.textContent;
      button.disabled = true;
      button.firstChild!.textContent = ui.sending + ' ';
      const fail = (msg: string) => { $('[data-form-err]').textContent = msg; };
      try {
        const res = await fetch('/api/register', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.url) { window.location.assign(body.url); return; }
        if (res.ok && body.ok) { window.location.assign(`${ui.thanks}?r=${encodeURIComponent(body.id ?? '')}&free=1`); return; }
        if (res.status === 422 && body.errors) showErrors(body.errors);
        else if (res.status === 409) fail(ui.errDuplicate);
        else if (res.status === 503) fail(ui.errUnavailable);
        else fail(ui.errGeneric);
      } catch {
        fail(ui.errGeneric);
      }
      button.disabled = false;
      button.firstChild!.textContent = label;
      if (turnstile && (window as any).turnstile) { (window as any).turnstile.reset(); token = ''; }
    });
  }
</script>
