---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <h1 class="reveal reveal-1">{title}</h1>
    {Astro.slots.has('default') ? <p class="lead reveal reveal-2"><slot /></p> : lead && <p class="lead reveal reveal-2">{lead}</p>}
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(1.5rem, 4vw, 3rem) var(--space-5); border-bottom: 1px solid var(--line); position: relative; z-index: 1; }
  .page-hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); margin-block: var(--space-4); max-width: none; }
  .page-hero .eyebrow { margin-bottom: 0; }
  .page-hero .lead { max-width: 60rem; }
  .page-hero .lead :global(a) { text-decoration: underline; text-underline-offset: 4px; }
</style>
