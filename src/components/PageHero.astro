---
import { localeFromPath, messages } from '../i18n/utils';

// Every page shows the same place and dates above its title.
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
const { place, dates } = messages[localeFromPath(Astro.url.pathname)].common;
const eyebrow = `${place} · ${dates}`;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="reveal reveal-1">{title}</h1>
    {Astro.slots.has('default') ? <p class="lead reveal reveal-2"><slot /></p> : lead && <p class="lead reveal reveal-2">{lead}</p>}
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(1.5rem, 4vw, 3rem) var(--space-5); border-bottom: 1px solid var(--line); position: relative; z-index: 1; }
  .page-hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); margin-block: var(--space-4); max-width: none; }
  .page-hero .eyebrow { margin-bottom: 0; }
  /* Phones: the place and dates stay on one line, scaling with the screen width (same as the front page). */
  @media (max-width: 700px) { .page-hero .eyebrow { white-space: nowrap; font-size: min(0.75rem, 3.4vw); letter-spacing: 0.1em; } }
  .page-hero .lead { max-width: none; }
  .page-hero .lead :global(a) { text-decoration: underline; text-underline-offset: 4px; }
</style>
