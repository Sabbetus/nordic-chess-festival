---
import { schedule } from '../data/schedule';
import { formatDayLong, messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = messages[lang].tournament;

const days = [...new Set(schedule.map((i) => i.date))].map((date) => ({
  date,
  items: schedule.filter((i) => i.date === date),
}));
const label = (i: (typeof schedule)[number]) =>
  i.kind === 'round' ? `${t.round} ${i.round}` : i.kind === 'confirmation' ? t.confirmation : i.kind === 'opening' ? t.opening : t.prizegiving;
---

<ol class="timeline">
  {days.map((day) => (
    <li class="day">
      <h3>{formatDayLong(lang, day.date)}</h3>
      <ul>
        {day.items.map((i) => (
          <li class:list={['item', i.kind]}>
            <span class="time num">{i.kind === 'confirmation' ? `${t.until} ${i.time}` : i.time}</span>
            <span class="what">
              {label(i)}
              {i.kind === 'confirmation' && <small>{t.confirmationDetail}</small>}
            </span>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; border-top: 1px solid var(--line); }
  .day { display: grid; grid-template-columns: minmax(11rem, 16rem) 1fr; gap: var(--space-5); padding-block: var(--space-5); border-bottom: 1px solid var(--line); }
  .day h3 { font-size: 1.5rem; color: var(--white); text-transform: capitalize; }
  .day ul { list-style: none; display: grid; gap: var(--space-3); }
  .item { display: grid; grid-template-columns: 8.5rem 1fr; align-items: baseline; gap: var(--space-4); }
  .time { font-weight: 500; color: var(--muted); font-size: var(--text-sm); letter-spacing: 0.04em; }
  .what { color: var(--muted); }
  .what small { display: block; font-size: var(--text-sm); color: var(--muted-2); }
  .round .time { color: var(--ice); }
  .round .what { font-variant-numeric: lining-nums; font-feature-settings: "lnum" 1; color: var(--white); font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; line-height: 1.2; }
  .opening .what, .prizegiving .what, .confirmation .what { font-size: var(--text-base); }
  @media (max-width: 700px) { .day { grid-template-columns: 1fr; gap: var(--space-3); } .item { grid-template-columns: 7rem 1fr; } }
</style>
