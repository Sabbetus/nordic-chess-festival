---
import { schedule } from '../data/schedule';
import { formatDayLong, formatDayShort, messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = messages[lang].mainEvent;

const days = [...new Set(schedule.map((i) => i.date))].map((date) => ({
  date,
  items: schedule.filter((i) => i.date === date),
}));
const label = (i: (typeof schedule)[number]) =>
  i.kind === 'round' ? `${t.round} ${i.round}` : i.kind === 'confirmation' ? t.confirmation : i.kind === 'opening' ? t.opening : t.prizegiving;
---

<ol class="timeline">
  {days.map((day) => (
    <li class="day">
      <h3><span class="long">{formatDayLong(lang, day.date)}</span><span class="short">{formatDayShort(lang, day.date)}</span></h3>
      <ul>
        {day.items.map((i) => (
          <li class:list={['item', i.kind]}>
            {i.kind !== 'confirmation' && <span class="time num">{i.time}</span>}
            <span class="what">
              {label(i)}
              {i.kind === 'confirmation' && <small>{t.confirmationDetail}</small>}
            </span>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; border-top: 1px solid var(--line); }
  .day { display: grid; grid-template-columns: 13rem 1fr; gap: var(--space-4); padding-block: 0.85rem; border-bottom: 1px solid var(--line); align-items: baseline; }
  .day h3 { font-size: 1.25rem; line-height: 1.3; color: var(--white); }
  /* Only the first letter: Finnish month names are not capitalised. */
  .day h3::first-letter { text-transform: uppercase; }
  .day h3 .short { display: none; }
  .day ul { list-style: none; display: grid; gap: 0.3rem; }
  .item { display: grid; grid-template-columns: 4.5rem 1fr; align-items: baseline; gap: var(--space-3); }
  .time { font-weight: 500; color: var(--muted); font-size: var(--text-sm); letter-spacing: 0.04em; font-variant-numeric: tabular-nums lining-nums; }
  .what { color: var(--muted); line-height: 1.5; }
  .what small { display: block; font-size: var(--text-sm); color: var(--muted-2); line-height: 1.5; }
  .round .time { color: var(--ice); }
  .round .what { font-variant-numeric: lining-nums; font-feature-settings: "lnum" 1; color: var(--white); font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
  /* Confirmation has a time window rather than a time, so its text uses the full row. */
  .item.confirmation { grid-template-columns: 1fr; }
  @media (max-width: 700px) {
    /* Phones: a short date on the same line as the round, in the same two columns as on desktop. */
    .day { grid-template-columns: 5.6rem 1fr; gap: var(--space-3); padding-block: 0.7rem; }
    .day h3 { font-size: 1.05rem; }
    .day h3 .long { display: none; }
    .day h3 .short { display: inline; }
    .item { grid-template-columns: 3.3rem 1fr; gap: var(--space-2); }
  }
</style>
