---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localePath, messages, type Locale } from '../i18n/utils';

interface Props { guest: CollectionEntry<'guests'>; lang: Locale }
const { guest, lang } = Astro.props;
const m = messages[lang];
const d = guest.data;
const initials = d.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

<a class="guest" href={localePath(lang, `/guests/${guest.id}/`)}>
  <div class="photo">
    {d.photo ? (
      <Image src={d.photo} alt={d.photoAlt?.[lang] ?? d.name} widths={[320, 480, 640, 800]} sizes="(min-width: 1100px) 15rem, (min-width: 600px) 30vw, 90vw" style={d.photoPosition ? `object-position: ${d.photoPosition}` : undefined} />
    ) : (
      <span class="mono" aria-hidden="true">{initials}</span>
    )}
    {d.placeholder && <span class="badge">{m.guests.placeholderBadge}</span>}
  </div>
  <div class="info">
    <p class="eyebrow">{[d.title, d.federation, d.kind === 'streamer' ? m.guests.streamerLabel : null].filter(Boolean).join(' · ')}</p>
    <h3>{d.name}</h3>
    {d.tagline && <p class="tagline">{d.tagline[lang]}</p>}
  </div>
</a>

<style>
  .guest {
    position: relative; display: block; aspect-ratio: var(--guest-aspect, 3 / 4); overflow: hidden; border-radius: var(--radius);
    background: linear-gradient(160deg, var(--surface-2), var(--surface)); border: 1px solid var(--line);
    color: var(--white); transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .guest:hover { border-color: var(--ice-border); transform: translateY(-3px); color: var(--white); }
  .photo { position: absolute; inset: 0; display: grid; place-items: center; }
  .photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    filter: grayscale(1) contrast(1.05) brightness(0.92); transition: filter 0.5s var(--ease), transform 0.8s var(--ease);
  }
  .guest:hover .photo :global(img) { filter: grayscale(0.15) contrast(1.02); transform: scale(1.04); }
  .photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.96) 0%, rgba(10, 10, 10, 0.55) 38%, transparent 65%);
  }
  .mono { font-family: var(--font-display); font-size: 5rem; color: var(--ice); opacity: 0.5; }
  .badge {
    position: absolute; top: var(--space-3); left: var(--space-3); z-index: 1; font-size: var(--text-xs); letter-spacing: 0.1em;
    text-transform: uppercase; background: var(--black); color: var(--muted); border: 1px dashed var(--line-strong);
    padding: 0.25rem 0.55rem; border-radius: var(--radius);
  }
  .info { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: var(--space-4); display: grid; gap: 0.3rem; }
  .eyebrow { font-size: 0.65rem; letter-spacing: 0.2em; }
  h3 { font-size: 1.7rem; line-height: 1.15; margin: 0; }
  .tagline { font-size: var(--text-sm); color: var(--muted); line-height: 1.4; min-height: 2.8em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
