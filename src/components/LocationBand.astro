---
import { Image } from 'astro:assets';
import aerial from '../assets/kangasala-aerial.jpg';
import { messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = messages[lang].home.location;
---

<section class="location">
  <Image src={aerial} alt={l.alt} widths={[800, 1280, 1920]} sizes="100vw" class="bg" />
  <div class="shade" aria-hidden="true"></div>
  <div class="container copy">
    <p class="eyebrow rule">{l.eyebrow}</p>
    <h2>{l.title}</h2>
    <p class="lead">{l.text}</p>
  </div>
</section>

<style>
  .location { position: relative; isolation: isolate; min-height: clamp(24rem, 48vw, 36rem); display: flex; align-items: flex-end; overflow: hidden; border-block: 1px solid var(--line); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; z-index: -2; filter: saturate(0.85) brightness(0.8); }
  .shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to top, rgba(10, 10, 10, 0.95) 0%, rgba(10, 10, 10, 0.55) 40%, rgba(10, 10, 10, 0.1) 75%),
      linear-gradient(to right, rgba(10, 10, 10, 0.55), transparent 60%);
  }
  .copy { padding-block: var(--space-8) var(--space-7); display: grid; gap: var(--space-3); }
  .copy h2 { font-size: clamp(2.5rem, 5.5vw, 5rem); max-width: 30ch; }
  .copy .lead { color: var(--white); opacity: 0.85; max-width: 34rem; }
</style>
