---
import { messages, localePath, type Locale } from '../i18n/utils';
import { firstRoundStart, venue } from '../data/schedule';
import { rules } from '../data/fees';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = messages[lang].home.countdown;

// The early bird ends at the end of 31 January, Finnish time (UTC+2 in winter).
const earlyBirdEnd = `${rules.earlyBirdDeadline}T23:59:59+02:00`;

// Initial values at build time; the script below keeps them current in the browser.
const now = Date.now();
const target = now <= Date.parse(earlyBirdEnd) ? Date.parse(earlyBirdEnd) : Date.parse(firstRoundStart);
const ms = Math.max(0, target - now);
const parts = {
  d: Math.floor(ms / 86_400_000),
  h: Math.floor((ms % 86_400_000) / 3_600_000),
  m: Math.floor((ms % 3_600_000) / 60_000),
  s: Math.floor((ms % 60_000) / 1000),
};
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="countdown" data-countdown data-early-end={earlyBirdEnd} data-round-start={firstRoundStart}>
  <!-- Early bird mode is the default; the "early-bird-over" class on <html> switches to round 1. -->
  <p class="label cd-early">{c.earlyLabel}</p>
  <p class="label cd-round">{c.label}</p>
  <div class="digits">
    <div><span data-d class="num">{parts.d}</span><small>{c.days}</small></div>
    <div><span data-h class="num">{pad(parts.h)}</span><small>{c.hours}</small></div>
    <div><span data-m class="num">{pad(parts.m)}</span><small>{c.minutes}</small></div>
    <div><span data-s class="num">{pad(parts.s)}</span><small>{c.seconds}</small></div>
  </div>
  <p class="started" hidden>{c.started}</p>
  <div class="when cd-early">
    <p>{c.earlyWhen}</p>
    <a href={localePath(lang, '/register/')}>{c.earlyCta} →</a>
  </div>
  <div class="when cd-round">
    <p>{c.when}</p>
    <span>{venue.name}</span>
  </div>
</div>

<style>
  .countdown {
    background: rgba(17, 17, 17, 0.62); border: 1px solid var(--ice-border); border-radius: var(--radius);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    padding: var(--space-5) var(--space-6); display: grid; gap: var(--space-4);
    box-shadow: 0 0 80px rgba(126, 200, 227, 0.08);
  }
  .label { font-size: var(--text-xs); letter-spacing: 0.24em; text-transform: uppercase; color: var(--ice); font-weight: 500; }
  .digits { display: grid; grid-template-columns: 1.45fr 1fr 1fr 1fr; gap: var(--space-3); }
  .digits div { display: grid; gap: 0.35rem; }
  .digits .num { font-weight: 300; font-size: clamp(2.25rem, 3.7vw, 3.5rem); line-height: 1; letter-spacing: -0.02em; color: var(--white); font-variant-numeric: tabular-nums; }
  .digits small { font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .when { font-size: var(--text-sm); color: var(--muted); border-top: 1px solid var(--line); padding-top: var(--space-4); line-height: 1.6; display: grid; gap: 0.25rem; }
  .when p { color: var(--white); }
  .when a { color: var(--ice); font-weight: 500; }
  .when span { color: var(--muted); }
  .started { font-family: var(--font-display); font-size: 2rem; color: var(--ice); }

  /* Which mode is shown: early bird until the deadline, then round 1. */
  .cd-round { display: none; }
  :global(.early-bird-over) .cd-early { display: none; }
  :global(.early-bird-over) .cd-round { display: block; }
  :global(.early-bird-over) .when.cd-round { display: grid; }
  .is-started .digits, .is-started .cd-round, .is-started .cd-early { display: none !important; }

  @media (max-width: 480px) { .countdown { padding: var(--space-4); } .digits { gap: var(--space-2); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const earlyEnd = Date.parse(el.dataset.earlyEnd!);
    const roundStart = Date.parse(el.dataset.roundStart!);
    const d = el.querySelector('[data-d]')!;
    const h = el.querySelector('[data-h]')!;
    const m = el.querySelector('[data-m]')!;
    const s = el.querySelector('[data-s]')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const now = Date.now();
      const target = now <= earlyEnd ? earlyEnd : roundStart;
      const ms = target - now;
      if (ms <= 0) {
        el.classList.add('is-started');
        el.querySelector('.started')?.removeAttribute('hidden');
        return false;
      }
      d.textContent = String(Math.floor(ms / 86_400_000));
      h.textContent = pad(Math.floor((ms % 86_400_000) / 3_600_000));
      m.textContent = pad(Math.floor((ms % 3_600_000) / 60_000));
      s.textContent = pad(Math.floor((ms % 60_000) / 1000));
      return true;
    };
    if (tick()) {
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
    }
  });
</script>
