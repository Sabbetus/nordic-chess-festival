---
import { rounds } from '../data/schedule';
import { formatDayShort, messages, type Locale } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const round = messages[lang].mainEvent.round;
---

<ol class="tiles" aria-label={messages[lang].mainEvent.scheduleTitle}>
  {rounds.map((r) => (
    <li>
      <span class="n">{r.round}</span>
      <span class="r">{round}</span>
      <span class="d">{formatDayShort(lang, r.date)}</span>
      <span class="t num">{r.time}</span>
    </li>
  ))}
</ol>

<style>
  .tiles { list-style: none; display: grid; grid-template-columns: repeat(9, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  li { background: var(--surface); padding: var(--space-4) var(--space-3); display: grid; gap: 0.15rem; justify-items: start; position: relative; transition: background 0.25s var(--ease); }
  li:nth-child(even) { background: var(--surface-2); }
  li:hover { background: var(--ice-dim); }
  .n { font-variant-numeric: lining-nums; font-feature-settings: "lnum" 1; font-family: var(--font-display); font-size: 3rem; font-weight: 600; line-height: 1; color: var(--ice); }
  .r { font-size: var(--text-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); margin-bottom: var(--space-3); }
  .d { font-size: var(--text-sm); color: var(--white); font-weight: 400; white-space: nowrap; }
  .t { font-size: var(--text-sm); color: var(--muted); }
  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(3, 1fr); } .n { font-size: 2.5rem; } }
</style>
